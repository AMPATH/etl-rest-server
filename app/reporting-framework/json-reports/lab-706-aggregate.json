{
  "name": "lab706Aggregate",
  "version": "2.2",
  "tag": "lab-706-blood-chemistry-aggregate",
  "description": "Aggregate dataset for the MOH 706 report. Runs over lab706Base v2.2, whose test slots carry raw values (result_concept_id for coded tests, result_numeric for numeric tests), so the = 703 positivity rules and the numeric banding rules compare real data. Every test carries a total_/positive_ pair plus banding where authored. Aggregates without a GROUP BY on purpose: the report screen reads one summary row for the whole period and location selection. v2.2: panel indicators come from the base's member-aware flags over etl.flat_moh_706_report_results - total_fbc/total_lipid_profile/total_urinalysis count orders with >= 1 member result, positive_urinalysis counts orders where any dipstick member coded POSITIVE (previously always 0: panel head obs are valueless), fbc_hb_* bands read the HGB (21) member via the base fbc_hgb slot (previously one arbitrary member value was banded as if it were Hb). The *_with_members sums add urinalysis-member occurrences to the standalone analyte counts - aliases are additive; the legacy aliases stay comparable with historical numbers until the counting semantics are signed off.",
  "uses": [
    {
      "name": "lab706Base",
      "version": "2.2",
      "type": "dataset_def"
    }
  ],
  "sources": [
    {
      "dataSet": "lab706Base",
      "alias": "t1"
    }
  ],
  "dynamicJsonQueryGenerationDirectives": {
    "patientListGenerator": {
      "useTemplate": "lab706PatientList",
      "useTemplateVersion": "1.0",
      "generatingDirectives": {
        "joinDirectives": {
          "joinType": "INNER",
          "joinCondition": "<<base_column>> = <<template_column>>",
          "baseColumn": "person_id",
          "templateColumn": "person_id"
        }
      }
    }
  },
