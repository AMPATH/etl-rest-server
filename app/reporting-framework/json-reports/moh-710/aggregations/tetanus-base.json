{
  "name": "tetanusBase",
  "version": "1.0",
  "tag": "",
  "description": "",
  "uses": [],
  "sources": [
    {
      "table": "etl.flat_moh_710",
      "alias": "t"
    },

    {
      "table": "amrs.person",
      "alias": "p",
      "join": {
        "type": "INNER",
        "joinCondition": "t.person_id = p.person_id AND p.voided = 0"
      }
    },
    {
      "table": "amrs.location",
      "alias": "l",
      "join": {
        "type": "INNER",
        "joinCondition": "l.location_id = t.location_id"
      }
    }
  ],
  "columns": [
    {
      "type": "simple_column",
      "alias": "encounter_datetime",
      "column": "t.encounter_datetime"
    },
    {
      "type": "simple_column",
      "alias": "person_id",
      "column": "t.person_id"
    },
    {
      "type": "simple_column",
      "alias": "age",
      "column": "t.age_in_years"
    },
    {
      "type": "derived_column",
      "alias": "tetanus_toxoid1",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "if(t.tetanus_toxoid_vaccine = 1, 1, 0)"
      }
    },
    {
      "type": "derived_column",
      "alias": "tetanus_toxoid2",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "if(t.tetanus_toxoid_vaccine = 2, 1, 0)"
      }
    },
    {
      "type": "derived_column",
      "alias": "tetanus_toxoid3",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "if(t.tetanus_toxoid_vaccine = 3, 1, 0)"
      }
    },
    {
      "type": "derived_column",
      "alias": "tetanus_toxoid4",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "if(t.tetanus_toxoid_vaccine = 4, 1, 0)"
      }
    },
    {
      "type": "derived_column",
      "alias": "tetanus_toxoid5",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "if(t.tetanus_toxoid_vaccine = 5, 1, 0)"
      }
    },
    {
      "type": "derived_column",
      "alias": "hpv_vaccine1",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "null"
      }
    },
    {
      "type": "derived_column",
      "alias": "hpv_vaccine2",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "null"
      }
    }
  ],
  "filters": {
    "conditionJoinOperator": "and",
    "conditions": [
      {
        "filterType": "tableColumns",
        "conditionExpression": "t.encounter_type in (264,265, 313)"
      },
      {
        "filterType": "tableColumns",
        "conditionExpression": "DATE(t.encounter_datetime) >= ?",
        "parameterName": "startDate"
      },
      {
        "filterType": "tableColumns",
        "conditionExpression": "DATE(t.encounter_datetime) <= ?",
        "parameterName": "endDate"
      },
      {
        "filterType": "tableColumns",
        "conditionExpression": "t.location_id in ?",
        "parameterName": "locations"
      }
    ]
  },
  "groupBy": {
    "groupParam": "groupByParam",
    "columns": ["t.person_id"]
  }
}
