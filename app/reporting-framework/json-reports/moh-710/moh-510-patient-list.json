{
  "name": "moh_510_patient_list_template",
  "version": "1.0",
  "tag": "moh_510_patient_list_template",
  "description": "MOH 510 Patient list template",
  "uses": [
    {
      "name": "immunizationBase",
      "version": "1.0",
      "type": "dataset_def"
    }
  ],
  "sources": [
    {
      "dataSet": "immunizationBase",
      "alias": "a"
    },
    {
      "table": "amrs.person",
      "alias": "pn",
      "join": {
        "type": "INNER",
        "joinCondition": "pn.person_id = a.person_id"
      }
    },
    {
      "table": "amrs.patient_identifier",
      "alias": "nupi",
      "join": {
        "type": "LEFT",
        "joinCondition": "nupi.patient_id = a.person_id AND nupi.identifier_type = 45"
      }
    },
    {
      "table": "amrs.person_name",
      "alias": "person_name",
      "join": {
        "type": "INNER",
        "joinCondition": "a.person_id = person_name.person_id AND (person_name.voided IS NULL || person_name.voided = 0) AND person_name.preferred = 1"
      }
    },
    {
      "table": "amrs.person_attribute",
      "alias": "attribute",
      "join": {
        "type": "LEFT",
        "joinCondition": "attribute.person_id = a.person_id AND attribute.person_attribute_type_id = 10"
      }
    },
    {
      "table": "amrs.patient_identifier",
      "alias": "amrs",
      "join": {
        "type": "LEFT",
        "joinCondition": "a.person_id = amrs.patient_id AND (amrs.voided IS NULL || amrs.voided = 0) AND amrs.identifier_type = 8"
      }
    },
    {
      "table": "amrs.person_address",
      "alias": "pa",
      "join": {
        "type": "LEFT",
        "joinCondition": "a.person_id = pa.person_id"
      }
    }
  ],
  "columns": [
    {
      "type": "simple_column",
      "alias": "person_id",
      "column": "a.person_id"
    },
    {
      "type": "simple_column",
      "alias": "patient_uuid",
      "column": "pn.uuid"
    },
    {
      "type": "simple_column",
      "alias": "encounter_type",
      "column": "a.encounter_type"
    },
    {
      "type": "simple_column",
      "alias": "encounter_id",
      "column": "a.encounter_id"
    },
    {
      "type": "simple_column",
      "alias": "date",
      "column": "a.encounter_datetime"
    },
    {
      "type": "simple_column",
      "alias": "amrs_id",
      "column": "amrs.identifier"
    },
    {
      "type": "simple_column",
      "alias": "child_number",
      "column": "null"
    },
    {
      "type": "derived_column",
      "alias": "child_names",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": " CONCAT_WS(' ', COALESCE(person_name.given_name, ''), COALESCE(person_name.middle_name, ''), COALESCE(person_name.family_name, ''))"
      }
    },
    {
      "type": "simple_column",
      "alias": "sex",
      "column": "pn.gender"
    },
    {
      "type": "simple_column",
      "alias": "date_of_birth",
      "column": "pn.birthdate"
    },
    {
      "type": "simple_column",
      "alias": "date_first_seen",
      "column": "null"
    },
    {
      "type": "derived_column",
      "alias": "father_names",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": " CONCAT_WS(' ', COALESCE(person_name.given_name, ''), COALESCE(person_name.middle_name, ''), COALESCE(person_name.family_name, ''))"
      }
    },
    {
      "type": "derived_column",
      "alias": "mother_names",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": " CONCAT_WS(' ', COALESCE(person_name.given_name, ''), COALESCE(person_name.middle_name, ''), COALESCE(person_name.family_name, ''))"
      }
    },
    {
      "type": "simple_column",
      "alias": "village_estate_landmark",
      "column": "pa.city_village"
    },
    {
      "type": "simple_column",
      "alias": "phone_number",
      "column": "attribute.value"
    },
    {
      "type": "derived_column",
      "alias": "bcg",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "column": "IF(a.bcg_vaccine, a.encounter_datetime, NULL)"
      }
    },
    {
      "type": "derived_column",
      "alias": "polio_birth_dose",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "column": "IF(a.opv_vaccine, a.encounter_datetime, NULL)"
      }
    },
    {
      "type": "derived_column",
      "alias": "opv_1",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "column": "IF(a.opv_1, a.encounter_datetime, NULL)"
      }
    },
    {
      "type": "derived_column",
      "alias": "opv_2",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "column": "IF(a.opv_2, a.encounter_datetime, NULL)"
      }
    },
    {
      "type": "derived_column",
      "alias": "opv_3",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "column": "IF(a.opv_3, a.encounter_datetime, NULL)"
      }
    },
    {
      "type": "derived_column",
      "alias": "ipv",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "column": "IF(a.ipv_vaccine, a.encounter_datetime, NULL)"
      }
    },
    {
      "type": "derived_column",
      "alias": "dpt_hep_1",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "column": "IF(a.dpt_hep_1, a.encounter_datetime, NULL)"
      }
    },
    {
      "type": "derived_column",
      "alias": "dpt_hep_2",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "column": "IF(a.dpt_hep_2, a.encounter_datetime, NULL)"
      }
    },
    {
      "type": "derived_column",
      "alias": "dpt_hep_3",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "column": "IF(a.dpt_hep_3, a.encounter_datetime, NULL)"
      }
    },
    {
      "type": "derived_column",
      "alias": "pneumococcal_1",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "column": "IF(a.pneumococcal_1, a.encounter_datetime, NULL)"
      }
    },
    {
      "type": "derived_column",
      "alias": "pneumococcal_2",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "column": "IF(a.pneumococcal_2, a.encounter_datetime, NULL)"
      }
    },
    {
      "type": "derived_column",
      "alias": "pneumococcal_3",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "column": "IF(a.dpt_hep_3, a.encounter_datetime, NULL)"
      }
    },
    {
      "type": "derived_column",
      "alias": "rotavirus_1",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "column": "IF(a.rotavirus_vaccine1, a.encounter_datetime, NULL)"
      }
    },
    {
      "type": "derived_column",
      "alias": "rotavirus_2",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "column": "IF(a.rotavirus_vaccine2, a.encounter_datetime, NULL)"
      }
    },
    {
      "type": "derived_column",
      "alias": "vitamin_a_6_11_months",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "column": "IF(a.vitaminA_6_11_months, a.encounter_datetime, NULL)"
      }
    },
    {
      "type": "derived_column",
      "alias": "measles_rubella_1",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "column": "IF(a.measles_rubela_1, a.encounter_datetime, NULL)"
      }
    },
    {
      "type": "derived_column",
      "alias": "measles_rubella_2",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "column": "IF(a.measles_rubela_2, a.encounter_datetime, NULL)"
      }
    },
    {
      "type": "derived_column",
      "alias": "yellow_fever",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "column": "IF(a.yellow_fever_vaccine, a.encounter_datetime, NULL)"
      }
    },
    {
      "type": "derived_column",
      "alias": "fully_immunized_child",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "column": "IF(a.fully_immunized_children, a.encounter_datetime, NULL)"
      }
    },
    {
      "type": "derived_column",
      "alias": "remarks",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "null"
      }
    }
  ],
  "groupBy": {
    "columns": ["a.person_id"]
  },
  "orderBy": {
    "orderByParam": "orderByParam",
    "columns": [
      {
        "column": "a.encounter_datetime",
        "order": "asc"
      }
    ]
  }
}
