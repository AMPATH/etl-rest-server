{
  "name": "hypertentionAgeBase",
  "version": "1.0",
  "tag": "",
  "description": "",
  "uses": [],
  "sources": [
    {
      "table": "etl.monthly_diabetes_and_hypertention_report",
      "alias": "mdh"
    },
    {
      "table": "amrs.location",
      "alias": "l",
      "join": {
        "type": "inner",
        "joinCondition": "mdh.location_id = l.location_id"
      }
    }
  ],
  "columns": [
    {
      "type": "simple_column",
      "alias": "person_id",
      "column": "mdh.person_id"
    },
    {
      "type": "simple_column",
      "alias": "location_id",
      "column": "mdh.location_id"
    },
    {
      "type": "simple_column",
      "alias": "location",
      "column": "l.name"
    },
    {
      "type": "simple_column",
      "alias": "gender",
      "column": "mdh.gender"
    },
    {
      "type": "simple_column",
      "alias": "endDate",
      "column": "mdh.endDate"
    },
    {
      "type": "derived_column",
      "alias": "has_htn",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "IF(mdh.has_htn = 1 AND mdh.revisit_this_month = 1,1,NULL)"
      }
    },
    {
      "type": "derived_column",
      "alias": "newly_diagnosed_htn_this_month",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "IF(mdh.newly_diagnosed_htn_this_month = 1,1,NULL)"
      }
    },
    {
      "type": "derived_column",
      "alias": "revisit_known_htn",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "IF(mdh.revisit_this_month = 1 AND mdh.newly_diagnosed_htn_this_month = 0,1,NULL)"
      }
    },
    {
      "type": "derived_column",
      "alias": "tbs_status",
      "expressionType": "case_statement",
      "expressionOptions": {
        "caseOptions": [
          {
            "condition": "mdh.tb_screening_status = 1107",
            "value": "No signs"
          },
          {
            "condition": "mdh.tb_screening_status = 6176",
            "value": "On TB Treatment"
          },
          {
            "condition": "mdh.tb_screening_status = 6971",
            "value": "Presumed TB"
          }
        ]
      }
    },
    {
      "type": "derived_column",
      "alias": "bp",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "CONCAT(mdh.systolic,' / ',mdh.diastolic)"
      }
    },
    {
      "type": "derived_column",
      "alias": "age_range",
      "expressionType": "case_statement",
      "expressionOptions": {
        "caseOptions": [
          {
            "condition": "TIMESTAMPDIFF(YEAR,mdh.birthdate,mdh.endDate) >= 0 AND TIMESTAMPDIFF(YEAR,mdh.birthdate,mdh.endDate) <= 9",
            "value": "0_to_9"
          },
          {
            "condition": "TIMESTAMPDIFF(YEAR,mdh.birthdate,mdh.endDate) >= 10 AND TIMESTAMPDIFF(YEAR,mdh.birthdate,mdh.endDate) <= 19",
            "value": "10_to_19"
          },
          {
            "condition": "TIMESTAMPDIFF(YEAR,mdh.birthdate,mdh.endDate) >= 20 AND TIMESTAMPDIFF(YEAR,mdh.birthdate,mdh.endDate) <= 35",
            "value": "20_to_35"
          },
          {
            "condition": "TIMESTAMPDIFF(YEAR,mdh.birthdate,mdh.endDate) >= 36 AND TIMESTAMPDIFF(YEAR,mdh.birthdate,mdh.endDate) <= 60",
            "value": "36_to_60"
          },
          {
            "condition": "TIMESTAMPDIFF(YEAR,mdh.birthdate,mdh.endDate) >= 61",
            "value": "61_and_above"
          }
        ]
      }
    }
  ],
  "filters": {
    "conditionJoinOperator": "and",
    "conditions": [
      {
        "filterType": "tableColumns",
        "conditionExpression": "mdh.endDate = ?",
        "parameterName": "endDate"
      },
      {
        "filterType": "tableColumns",
        "conditionExpression": "mdh.location_id in ?",
        "parameterName": "locations"
      },
      {
        "filterType": "tableColumns",
        "conditionExpression": "mdh.revisit_this_month = 1 OR mdh.newly_diagnosed_htn_this_month = 0"
      },
      {
        "filterType": "tableColumns",
        "conditionExpression": "mdh.has_htn = 1"
      }
    ]
  },
  "groupBy": {
    "groupParam": "groupByParam",
    "columns": ["person_id"]
  }
}
