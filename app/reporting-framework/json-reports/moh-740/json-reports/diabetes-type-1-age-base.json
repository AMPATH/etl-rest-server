{
  "name": "diabetesType1AgeBase",
  "version": "1.0",
  "tag": "",
  "description": "",
  "uses": [],
  "sources": [
    {
      "table": "etl.monthly_diabetes_and_hypertention_report",
      "alias": "mdh"
    },
    {
      "table": "amrs.location",
      "alias": "l",
      "join": {
        "type": "inner",
        "joinCondition": "mdh.location_id = l.location_id"
      }
    }
  ],
  "columns": [
    {
      "type": "simple_column",
      "alias": "person_id",
      "column": "mdh.person_id"
    },
    {
      "type": "derived_column",
      "alias": "cumulative_all",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "IF(mdh.person_id IS NOT NULL,1,NULL)"
      }
    },
    {
      "type": "simple_column",
      "alias": "location_id",
      "column": "mdh.location_id"
    },
    {
      "type": "simple_column",
      "alias": "location",
      "column": "l.name"
    },
    {
      "type": "simple_column",
      "alias": "gender",
      "column": "mdh.gender"
    },
    {
      "type": "simple_column",
      "alias": "endDate",
      "column": "mdh.endDate"
    },
    {
      "type": "simple_column",
      "alias": "weight",
      "column": "mdh.weight"
    },
    {
      "type": "simple_column",
      "alias": "height",
      "column": "mdh.height"
    },
    {
      "type": "simple_column",
      "alias": "bmi",
      "column": "mdh.bmi"
    },
    {
      "type": "simple_column",
      "alias": "rbs",
      "column": "mdh.rbs"
    },
    {
      "type": "simple_column",
      "alias": "fbs",
      "column": "mdh.fbs"
    },
    {
      "type": "simple_column",
      "alias": "waist_circumference",
      "column": "mdh.waist_circumference"
    },
    {
      "type": "derived_column",
      "alias": "bp",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "CONCAT(mdh.systolic,' / ',mdh.diastolic)"
      }
    },
    {
      "type": "derived_column",
      "alias": "rtc_date",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "DATE_FORMAT(mdh.rtc_date,'%Y-%m-%d')"
      }
    },
    {
      "type": "derived_column",
      "alias": "htn",
      "expressionType": "case_statement",
      "expressionOptions": {
        "caseOptions": [
          {
            "condition": "mdh.htn_type = 7285",
            "value": "a"
          },
          {
            "condition": "mdh.htn_type = 7286",
            "value": "b"
          }
        ]
      }
    },
    {
      "type": "derived_column",
      "alias": "diabetes",
      "expressionType": "case_statement",
      "expressionOptions": {
        "caseOptions": [
          {
            "condition": "mdh.diabetes_status = 7281",
            "value": "Newly Diagnosed"
          },
          {
            "condition": "mdh.diabetes_status = 7282",
            "value": "Previously Known diagnosis"
          }
        ]
      }
    },
    {
      "type": "derived_column",
      "alias": "tbs_status",
      "expressionType": "case_statement",
      "expressionOptions": {
        "caseOptions": [
          {
            "condition": "mdh.tb_screening_status = 1107",
            "value": "No signs"
          },
          {
            "condition": "mdh.tb_screening_status = 6176",
            "value": "On TB Treatment"
          },
          {
            "condition": "mdh.tb_screening_status = 6971",
            "value": "Presumed TB"
          }
        ]
      }
    },
    {
      "type": "derived_column",
      "alias": "screened_for_tb",
      "expressionType": "case_statement",
      "expressionOptions": {
        "caseOptions": [
          {
            "condition": "mdh.screened_for_tb_this_month = 1",
            "value": "Yes"
          },
          {
            "condition": "mdh.screened_for_tb_this_month = 0",
            "value": "No"
          },
          {
            "condition": "mdh.screened_for_tb_this_month IS NULL",
            "value": "No"
          }
        ]
      }
    },
    {
      "type": "derived_column",
      "alias": "bp",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "CONCAT(mdh.systolic,' / ',mdh.diastolic)"
      }
    },
    {
      "type": "derived_column",
      "alias": "both_htn_and_diabetic",
      "expressionType": "case_statement",
      "expressionOptions": {
        "caseOptions": [
          {
            "condition": "mdh.co_morbid_type = 1154",
            "value": "Newly Diagnosed"
          },
          {
            "condition": "mdh.diabetes_status = 12778",
            "value": "Previously Known diagnosis"
          }
        ]
      }
    },
    {
      "type": "derived_column",
      "alias": "age_range",
      "expressionType": "case_statement",
      "expressionOptions": {
        "caseOptions": [
          {
            "condition": "TIMESTAMPDIFF(YEAR,mdh.birthdate, mdh.endDate) <= 5",
            "value": "0_to_5"
          },
          {
            "condition": "TIMESTAMPDIFF(YEAR,mdh.birthdate,mdh.endDate) >= 6 AND TIMESTAMPDIFF(YEAR,mdh.birthdate,mdh.endDate) <= 9",
            "value": "6_to_9"
          },
          {
            "condition": "TIMESTAMPDIFF(YEAR,mdh.birthdate,mdh.endDate) >= 10 AND TIMESTAMPDIFF(YEAR,mdh.birthdate,mdh.endDate) <= 19",
            "value": "10_to_19"
          },
          {
            "condition": "TIMESTAMPDIFF(YEAR,mdh.birthdate,mdh.endDate) >= 20 AND TIMESTAMPDIFF(YEAR,mdh.birthdate,mdh.endDate) <= 35",
            "value": "20_to_35"
          },
          {
            "condition": "TIMESTAMPDIFF(YEAR,mdh.birthdate, mdh.endDate) >= 36",
            "value": "36_and_above"
          }
        ]
      }
    },
    {
      "type": "derived_column",
      "alias": "type_1_diabetes_mellitus",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "IF(mdh.diabetes_mellitus_type = 9325,1,NULL)"
      }
    },
    {
      "type": "derived_column",
      "alias": "disease_type",
      "expressionType": "case_statement",
      "expressionOptions": {
        "caseOptions": [
          {
            "condition": "mdh.has_htn = 1 AND mdh.diabetes_mellitus_type is null",
            "value": "HYPERTENSION"
          },
          {
            "condition": "mdh.has_htn IS NULL AND mdh.diabetes_mellitus_type = 9325",
            "value": "DIABETES MELLITUS TYPE 1"
          },
          {
            "condition": "mdh.has_htn IS NULL AND mdh.diabetes_mellitus_type = 9326",
            "value": "DIABETES MELLITUS TYPE 2"
          },
          {
            "condition": "mdh.has_htn IS NULL AND mdh.diabetes_mellitus_type = 8879",
            "value": "GESTATIONAL DIABETES"
          },
          {
            "condition": "mdh.is_co_morbid = 1",
            "value": "CORMOBID"
          }
        ]
      }
    },
    {
      "type": "derived_column",
      "alias": "hiv_status",
      "expressionType": "case_statement",
      "expressionOptions": {
        "caseOptions": [
          {
            "condition": "mdh.hiv_status = 664",
            "value": "Negative"
          },
          {
            "condition": "mdh.hiv_status = 703",
            "value": "Positive"
          },
          {
            "condition": "mdh.hiv_status = 1067",
            "value": "Uknown"
          },
          {
            "condition": "mdh.hiv_status = 10707",
            "value": "Known Positive"
          }
        ]
      }
    },
    {
      "type": "derived_column",
      "alias": "rtc_date",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "DATE_FORMAT(mdh.rtc_date,'%Y-%m-%d')"
      }
    },
    {
      "type": "simple_column",
      "alias": "encounter_date",
      "column": "DATE_FORMAT(mdh.encounter_date, '%Y-%m-%d')"
    },
    {
      "type": "derived_column",
      "alias": "diabetes_meds",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "CONCAT(mdh.insulin_meds,' ',mdh.ogla_meds)"
      }
    },
    {
      "type": "simple_column",
      "alias": "systolic",
      "column": "mdh.systolic"
    },
    {
      "type": "simple_column",
      "alias": "diastolic",
      "column": "mdh.diastolic"
    },
    {
      "type": "simple_column",
      "alias": "hba1c",
      "column": "mdh.hba1c"
    }
  ],
  "filters": {
    "conditionJoinOperator": "and",
    "conditions": [
      {
        "filterType": "tableColumns",
        "conditionExpression": "mdh.endDate = ?",
        "parameterName": "endDate"
      },
      {
        "filterType": "tableColumns",
        "conditionExpression": "mdh.location_id in ?",
        "parameterName": "locations"
      },
      {
        "filterType": "tableColumns",
        "conditionExpression": "mdh.diabetes_mellitus_type = 9325"
      },
      {
        "filterType": "tableColumns",
        "conditionExpression": "mdh.revisit_this_month = 1 OR mdh.newly_diagnosed_diabetes_this_month = 1"
      }
    ]
  },
  "groupBy": {
    "groupParam": "groupByParam",
    "columns": ["person_id"]
  }
}
