{
  "name": "moh740ReportBase",
  "version": "1.0",
  "tag": "",
  "uses": [],
  "sources": [
    {
      "table": "etl.monthly_diabetes_and_hypertention_report",
      "alias": "mdh"
    }
  ],
  "columns": [
    {
      "type": "simple_column",
      "alias": "person_id",
      "column": "mdh.person_id"
    },
    {
      "type": "simple_column",
      "alias": "endDate",
      "column": "mdh.endDate"
    },
    {
      "type": "simple_column",
      "alias": "facility",
      "column": "mdh.facility"
    },
    {
      "type": "simple_column",
      "alias": "mfl_code",
      "column": "mdh.mfl_code"
    },
    {
      "type": "simple_column",
      "alias": "county",
      "column": "mdh.county"
    },
    {
      "type": "simple_column",
      "alias": "sub_county",
      "column": "mdh.sub_county"
    },
    {
      "type": "simple_column",
      "alias": "cumulative_in_care",
      "column": "mdh.cumulative_in_care"
    },
    {
      "type": "derived_column",
      "alias": "cumulative_all",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "IF(mdh.person_id IS NOT NULL,1,NULL)"
      }
    },
    {
      "type": "derived_column",
      "alias": "newly_diagnosed_diabetes_this_month",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "IF(mdh.newly_diagnosed_diabetes_this_month = 1, 1,NULL)"
      }
    },
    {
      "type": "derived_column",
      "alias": "revisit_to_clinic_known_dm",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "IF(mdh.revisit_this_month = 1  AND mdh.newly_diagnosed_diabetes_this_month = 0 AND mdh.diabetes_mellitus_type IN (9325,9326,8879), 1,NULL)"
      }
    },
    {
      "type": "derived_column",
      "alias": "type_1_diabetes",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "IF(mdh.diabetes_mellitus_type = 9325,1,NULL)"
      }
    },
    {
      "type": "derived_column",
      "alias": "type_2_diabetes",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "IF(mdh.diabetes_mellitus_type = 9326,1,NULL)"
      }
    },
    {
      "type": "derived_column",
      "alias": "cumulative_htn_patient",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "IF(mdh.has_htn = 1,1,NULL)"
      }
    },
    {
      "type": "derived_column",
      "alias": "cumulative_diabetes_patients_in_care",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "IF(mdh.cumulative_diabetes_patients_in_care = 1 OR mdh.is_co_morbid = 1 ,1,NULL)"
      }
    },
    {
      "type": "simple_column",
      "alias": "location_id",
      "column": "mdh.location_id"
    },
    {
      "type": "simple_column",
      "alias": "gender",
      "column": "mdh.gender"
    },
    {
      "type": "simple_column",
      "alias": "encounter_date",
      "column": "DATE_FORMAT(mdh.encounter_date, '%Y-%m-%d')"
    },
    {
      "type": "simple_column",
      "alias": "endDate",
      "column": "mdh.endDate"
    },
    {
      "type": "simple_column",
      "alias": "covered_by_shif",
      "column": "mdh.covered_by_shif"
    },
    {
      "type": "simple_column",
      "alias": "screened_for_tb_this_month",
      "column": "mdh.screened_for_tb_this_month"
    },
    {
      "type": "derived_column",
      "alias": "screened_postive_for_tb_this_month",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "IF(mdh.screened_for_tb_this_month = 1 AND mdh.tb_screening_status IN (6176,6971),1,NULL)"
      }
    },
    {
      "type": "derived_column",
      "alias": "screened_for_diabetic_foot_this_month",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "IF(mdh.screened_for_diabetic_foot_this_month = 1,1,NULL)"
      }
    },
    {
      "type": "derived_column",
      "alias": "has_diabetic_foot",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "IF(mdh.screened_for_diabetic_foot_this_month = 1 AND mdh.has_diabetic_foot = 1,1,NULL)"
      }
    },
    {
      "type": "derived_column",
      "alias": "type_1_diabetes_mellitus",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "IF(mdh.diabetes_mellitus_type = 9325,1,NULL)"
      }
    },
    {
      "type": "derived_column",
      "alias": "type_2_diabetes_mellitus",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "IF(mdh.diabetes_mellitus_type = 9326,1,NULL)"
      }
    },
    {
      "type": "derived_column",
      "alias": "gestatational_diabetes_mellitus",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "IF(mdh.diabetes_mellitus_type = 8879 AND revisit_this_month = 1,1,NULL)"
      }
    },
    {
      "type": "derived_column",
      "alias": "amputation_due_to_diabetic_foot",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "IF(mdh.amputation_due_to_diabetic_foot = 1,1,NULL)"
      }
    },
    {
      "type": "derived_column",
      "alias": "stroke_diagnosis",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "IF(mdh.stroke_diagnosis = 1,1,NULL)"
      }
    },
    {
      "type": "derived_column",
      "alias": "ischemic_heart_disease_diagnosis",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "IF(mdh.ischemic_heart_disease_diagnosis = 1,1,NULL)"
      }
    },
    {
      "type": "derived_column",
      "alias": "heart_failure_diagnosis",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "IF(mdh.heart_failure_diagnosis = 1,1,NULL)"
      }
    },
    {
      "type": "derived_column",
      "alias": "has_neuropathies",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "IF(mdh.has_neuropathies = 1,1,NULL)"
      }
    },
    {
      "type": "derived_column",
      "alias": "newly_diagnosed_htn_this_month",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "IF(mdh.newly_diagnosed_htn_this_month = 1,1,NULL)"
      }
    },
    {
      "type": "derived_column",
      "alias": "revisit_known_htn",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "IF(mdh.revisit_this_month = 1 AND mdh.newly_diagnosed_htn_this_month = 0 and mdh.has_htn = 1,1,NULL)"
      }
    },
    {
      "type": "derived_column",
      "alias": "is_co_morbid",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "IF(mdh.is_co_morbid = 1,1,NULL)"
      }
    },
    {
      "type": "derived_column",
      "alias": "revisit_known_co_morbid",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "IF(mdh.is_co_morbid = 1 AND mdh.co_morbid_type = 12778,1,NULL)"
      }
    },
    {
      "type": "derived_column",
      "alias": "newly_diagnosed_co_morbid_this_month",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "IF(mdh.newly_diagnosed_co_morbid_this_month = 1,1,NULL)"
      }
    },
    {
      "type": "derived_column",
      "alias": "on_insulin_this_month",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "IF(mdh.on_insulin_this_month = 1,1,NULL)"
      }
    },
    {
      "type": "derived_column",
      "alias": "on_ogla_meds_this_month",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "IF(mdh.on_ogla_meds_this_month = 1,1,NULL)"
      }
    },
    {
      "type": "derived_column",
      "alias": "on_both_insulin_and_ogla_meds_this_month",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "IF(mdh.on_insulin_this_month = 1 AND mdh.on_ogla_meds_this_month = 1,1,NULL)"
      }
    },
    {
      "type": "derived_column",
      "alias": "done_hba1c_this_month",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "IF(mdh.done_hba1c_this_month = 1,1,NULL)"
      }
    },
    {
      "type": "derived_column",
      "alias": "hba1c_less_than_7_percent_this_month",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "IF(mdh.done_hba1c_this_month = 1 AND mdh.hba1c < 7,1,NULL)"
      }
    },
    {
      "type": "derived_column",
      "alias": "on_exercise_and_diet",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "IF(mdh.on_exercise = 1 AND mdh.on_diet = 1 ,1,NULL)"
      }
    },
    {
      "type": "derived_column",
      "alias": "on_antihypertensives_this_month",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "IF(mdh.on_antihypertensives_this_month = 1,1,NULL)"
      }
    },
    {
      "type": "derived_column",
      "alias": "high_bp",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "IF(mdh.systolic >= 140 OR mdh.diastolic >= 90 ,1,NULL)"
      }
    },
    {
      "type": "simple_column",
      "alias": "enrollment_date",
      "column": "DATE_FORMAT(mdh.enrollment_date, '%Y-%m-%d')"
    },
    {
      "type": "derived_column",
      "alias": "diagnosis_at_enrollment",
      "expressionType": "case_statement",
      "expressionOptions": {
        "caseOptions": [
          {
            "condition": "mdh.primary_diagnosis_at_enrollment = 9325",
            "value": "Type 1 Diabetes Mellitus"
          },
          {
            "condition": "mdh.primary_diagnosis_at_enrollment IN (9326,44193)",
            "value": "Type 2 Diabetes Mellitus"
          },
          {
            "condition": "mdh.primary_diagnosis_at_enrollment = 8879",
            "value": "Gesta�onal Diabetes Mellitus"
          },
          {
            "condition": "mdh.primary_diagnosis_at_enrollment IN(903,38566,38559,38557,38550,38543,38541)",
            "value": "Hypertension"
          },
          {
            "condition": "mdh.primary_diagnosis_at_enrollment = 47",
            "value": "Preeclampsia"
          },
          {
            "condition": "mdh.primary_diagnosis_at_enrollment = 1456",
            "value": "Other NCD (specify)"
          },
          {
            "condition": "mdh.primary_diagnosis_at_enrollment = 7996",
            "value": "Peripheral Vascular Disease"
          },
          {
            "condition": "mdh.primary_diagnosis_at_enrollment = 8087",
            "value": "Diabetic foot Ulcer"
          }
        ]
      }
    },
    {
      "type": "derived_column",
      "alias": "year_of_diagnosis",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "extract(year from (from_days(datediff(endDate,enrollment_date))))"
      }
    },
    {
      "type": "simple_column",
      "alias": "weight",
      "column": "mdh.weight"
    },
    {
      "type": "simple_column",
      "alias": "height",
      "column": "mdh.height"
    },
    {
      "type": "simple_column",
      "alias": "bmi",
      "column": "mdh.bmi"
    },
    {
      "type": "derived_column",
      "alias": "bp",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "CONCAT(mdh.systolic,' / ',mdh.diastolic)"
      }
    },
    {
      "type": "derived_column",
      "alias": "rtc_date",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "DATE_FORMAT(mdh.rtc_date,'%Y-%m-%d')"
      }
    },
    {
      "type": "derived_column",
      "alias": "htn",
      "expressionType": "case_statement",
      "expressionOptions": {
        "caseOptions": [
          {
            "condition": "mdh.htn_type = 7285",
            "value": "Newly Diagnosed"
          },
          {
            "condition": "mdh.htn_type = 7286",
            "value": "Previously Known diagnosis"
          }
        ]
      }
    },
    {
      "type": "derived_column",
      "alias": "diabetes",
      "expressionType": "case_statement",
      "expressionOptions": {
        "caseOptions": [
          {
            "condition": "mdh.diabetes_status = 7281",
            "value": "Newly Diagnosed"
          },
          {
            "condition": "mdh.diabetes_status = 7282",
            "value": "Previously Known diagnosis"
          }
        ]
      }
    },
    {
      "type": "derived_column",
      "alias": "both_htn_and_diabetic",
      "expressionType": "case_statement",
      "expressionOptions": {
        "caseOptions": [
          {
            "condition": "mdh.co_morbid_type = 1154",
            "value": "Newly Diagnosed"
          },
          {
            "condition": "mdh.diabetes_status = 12778",
            "value": "Previously Known diagnosis"
          }
        ]
      }
    },
    {
      "type": "derived_column",
      "alias": "screened_for_tb",
      "expressionType": "case_statement",
      "expressionOptions": {
        "caseOptions": [
          {
            "condition": "mdh.screened_for_tb_this_month = 1",
            "value": "Yes"
          },
          {
            "condition": "mdh.screened_for_tb_this_month = 0",
            "value": "No"
          },
          {
            "condition": "mdh.screened_for_tb_this_month IS NULL",
            "value": "No"
          }
        ]
      }
    },
    {
      "type": "derived_column",
      "alias": "tbs_status",
      "expressionType": "case_statement",
      "expressionOptions": {
        "caseOptions": [
          {
            "condition": "mdh.tb_screening_status = 1107",
            "value": "No signs"
          },
          {
            "condition": "mdh.tb_screening_status = 6176",
            "value": "On TB Treatment"
          },
          {
            "condition": "mdh.tb_screening_status = 6971",
            "value": "Presumed TB"
          }
        ]
      }
    }
  ],
  "filters": {
    "conditionJoinOperator": "and",
    "conditions": [
      {
        "filterType": "tableColumns",
        "conditionExpression": "mdh.endDate = ?",
        "parameterName": "endDate"
      },
      {
        "filterType": "tableColumns",
        "conditionExpression": "mdh.location_id in ?",
        "parameterName": "locations"
      }
    ]
  },
  "groupBy": {
    "groupParam": "groupByParam",
    "columns": ["person_id"]
  }
}
