{
  "name": "Moh7312023PrepAggregation",
  "version": "1.0",
  "tag": "",
  "description": "PrEP boxes (1.3, 1.4, 1.5) of the MOH 731 Ver. July 2023 form, summed per location. Shaped like the section 3 aggregation so the report can fold both onto the same location row. Each sum is coalesced to 0: a box that was counted and found nothing reads 0, which is what the form asks for, and is told apart from a box this build does not compute, which stays blank.",
  "uses": [
    {
      "name": "Moh7312023PrepBase",
      "version": "1.0",
      "type": "dataset_def"
    }
  ],
  "sources": [
    {
      "dataSet": "Moh7312023PrepBase",
      "alias": "pb"
    }
  ],
  "columns": [
    {
      "type": "derived_column",
      "alias": "join_location",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "1"
      }
    },
    {
      "type": "simple_column",
      "alias": "location_uuid",
      "column": "pb.location_uuid"
    },
    {
      "type": "simple_column",
      "alias": "location",
      "column": "pb.location"
    },
    {
      "type": "simple_column",
      "alias": "location_id",
      "column": "pb.location_id"
    },
    {
      "type": "derived_column",
      "alias": "prep_new_male_general_pop",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "IFNULL(SUM(pb.prep_new_male_general_pop), 0)"
      }
    },
    {
