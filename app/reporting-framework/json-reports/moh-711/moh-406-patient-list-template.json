{
  "name": "moh_406_patient_list_template",
  "version": "1.0",
  "tag": "moh_406_patient_list_template",
  "description": "MOH 406 Patient list template",
  "uses": [
    {
      "name": "pncBase",
      "version": "1.0",
      "type": "dataset_def"
    }
  ],
  "sources": [
    {
      "dataSet": "pncBase",
      "alias": "a"
    },
    {
      "table": "amrs.person",
      "alias": "pn",
      "join": {
        "type": "INNER",
        "joinCondition": "pn.person_id = a.person_id AND pn.voided = 0"
      }
    },
    {
      "table": "amrs.patient_identifier",
      "alias": "pnc_number",
      "join": {
        "type": "LEFT",
        "joinCondition": "pnc_number.patient_id = a.person_id AND pnc_number.identifier_type = 48"
      }
    },
    {
      "table": "amrs.patient_identifier",
      "alias": "nupi",
      "join": {
        "type": "LEFT",
        "joinCondition": "nupi.patient_id = a.person_id AND nupi.identifier_type = 45"
      }
    },
    {
      "table": "amrs.person_name",
      "alias": "person_name",
      "join": {
        "type": "LEFT",
        "joinCondition": "a.person_id = person_name.person_id AND (person_name.voided IS NULL || person_name.voided = 0) AND person_name.preferred = 1"
      }
    },
    {
      "table": "amrs.person_attribute",
      "alias": "attribute",
      "join": {
        "type": "LEFT",
        "joinCondition": "attribute.person_id = a.person_id AND attribute.person_attribute_type_id = 10"
      }
    },
    {
      "table": "amrs.patient_identifier",
      "alias": "amrs",
      "join": {
        "type": "LEFT",
        "joinCondition": "a.person_id = amrs.patient_id AND (amrs.voided IS NULL || amrs.voided = 0) AND amrs.identifier_type = 8"
      }
    },
    {
      "table": "amrs.person_address",
      "alias": "pa",
      "join": {
        "type": "LEFT",
        "joinCondition": "a.person_id = pa.person_id"
      }
    }
  ],
  "columns": [
    {
      "type": "simple_column",
      "alias": "patient_uuid",
      "column": "pn.uuid"
    },
    {
      "type": "simple_column",
      "alias": "person_id",
      "column": "a.person_id"
    },
    {
      "type": "simple_column",
      "alias": "date_of_visit",
      "column": "a.encounter_datetime"
    },
    {
      "type": "simple_column",
      "alias": "pnc_number",
      "column": "pnc_number.identifier"
    },
    {
      "type": "simple_column",
      "alias": "nupi",
      "column": "nupi.identifier"
    },
    {
      "type": "simple_column",
      "alias": "amrs_id",
      "column": "amrs.identifier"
    },
    {
      "type": "derived_column",
      "alias": "full_names",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": " CONCAT_WS(' ', COALESCE(person_name.given_name, ''), COALESCE(person_name.middle_name, ''), COALESCE(person_name.family_name, ''))"
      }
    },
    {
      "type": "simple_column",
      "alias": "date_of_birth",
      "column": "pn.birthdate"
    },
    {
      "type": "simple_column",
      "alias": "age",
      "column": "a.age"
    },
    {
      "type": "simple_column",
      "alias": "county_sub_county",
      "column": "pa.county_district"
    },
    {
      "type": "simple_column",
      "alias": "village_estate_landmark",
      "column": "pa.city_village"
    },
    {
      "type": "simple_column",
      "alias": "phone_number",
      "column": "attribute.value"
    },
    {
      "type": "simple_column",
      "alias": "marital_status",
      "column": "a.marital_status"
    },
    {
      "type": "simple_column",
      "alias": "date_of_delivery",
      "column": "a.date_of_delivery"
    },
    {
      "type": "simple_column",
      "alias": "place_of_delivery",
      "column": "a.place_of_delivery"
    },
    {
      "type": "simple_column",
      "alias": "mode_of_delivery",
      "column": "a.mode_of_delivery"
    },
    {
      "type": "simple_column",
      "alias": "timing_mother",
      "column": "a.post_partum_timing_mother"
    },
    {
      "type": "simple_column",
      "alias": "timing_baby",
      "column": "a.post_partum_care_infants"
    },
    {
      "type": "simple_column",
      "alias": "temperature",
      "column": "a.temperature"
    },
    {
      "type": "simple_column",
      "alias": "pulse",
      "column": "a.pulse"
    },
    {
      "type": "derived_column",
      "alias": "blood_pressure",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "CONCAT_WS( '/', a.bp_systolic, a.bp_diastolic)"
      }
    },
    {
      "type": "simple_column",
      "alias": "pallor_present",
      "column": "a.pallor_present"
    },
    {
      "type": "simple_column",
      "alias": "breast",
      "column": "a.breast_exam"
    },
    {
      "type": "simple_column",
      "alias": "uterus",
      "column": "a.uterus"
    },
    {
      "type": "simple_column",
      "alias": "pph",
      "column": "a.pph"
    },
    {
      "type": "simple_column",
      "alias": "c_section_site",
      "column": "a.c_section_site"
    },
    {
      "type": "simple_column",
      "alias": "lochia",
      "column": "a.lochia"
    },
    {
      "type": "simple_column",
      "alias": "episiotomy",
      "column": "a.episiotomy"
    },
    {
      "type": "simple_column",
      "alias": "fistula",
      "column": "a.fistula"
    },
    {
      "type": "simple_column",
      "alias": "tb_screening",
      "column": "a.tb_screening"
    },
    {
      "type": "simple_column",
      "alias": "tested_pnc",
      "column": "a.hiv_test_type"
    },
    {
      "type": "simple_column",
      "alias": "hiv_test_1_kit_name",
      "column": "a.hiv_test_1_kit_name"
    },
    {
      "type": "simple_column",
      "alias": "hiv_test_1_lot_no",
      "column": "a.hiv_test_1_lot_no"
    },
    {
      "type": "simple_column",
      "alias": "hiv_test_1_expiry_date",
      "column": "a.hiv_test_1_expiry_date"
    },
    {
      "type": "simple_column",
      "alias": "hiv_test_1_test_result",
      "column": "a.hiv_test_1_test_result"
    },
    {
      "type": "simple_column",
      "alias": "hiv_test_2_kit_name",
      "column": "a.hiv_test_2_kit_name"
    },
    {
      "type": "simple_column",
      "alias": "hiv_test_2_lot_no",
      "column": "a.hiv_test_2_lot_no"
    },
    {
      "type": "simple_column",
      "alias": "hiv_test_2_expiry_date",
      "column": "a.hiv_test_2_expiry_date"
    },
    {
      "type": "simple_column",
      "alias": "hiv_test_2_test_result",
      "column": "a.hiv_test_2_test_result"
    },
    {
      "type": "simple_column",
      "alias": "hiv_test_3_kit_name",
      "column": "a.hiv_test_3_kit_name"
    },
    {
      "type": "simple_column",
      "alias": "hiv_test_3_lot_no",
      "column": "a.hiv_test_3_lot_no"
    },
    {
      "type": "simple_column",
      "alias": "hiv_test_3_expiry_date",
      "column": "a.hiv_test_3_expiry_date"
    },
    {
      "type": "simple_column",
      "alias": "hiv_test_3_test_result",
      "column": "a.hiv_test_3_test_result"
    },
    {
      "type": "simple_column",
      "alias": "hiv_test_results_pnc",
      "column": "a.hiv_results"
    },
    {
      "type": "simple_column",
      "alias": "hiv_result_pnc_less_6_weeks",
      "column": "null"
    },
    {
      "type": "simple_column",
      "alias": "hiv_result_pnc_greater_6_weeks",
      "column": "null"
    },
    {
      "type": "simple_column",
      "alias": "maternal_haart_less_6_weeks",
      "column": "null"
    },
    {
      "type": "simple_column",
      "alias": "maternal_haart_greater_6_weeks",
      "column": "null"
    },
    {
      "type": "simple_column",
      "alias": "infant_prophylaxis_less_6_weeks",
      "column": "null"
    },
    {
      "type": "simple_column",
      "alias": "infant_prophylaxis_greater_6_weeks",
      "column": "null"
    },
    {
      "type": "simple_column",
      "alias": "cervical_cancer_method",
      "column": "a.cervical_cancer_method"
    },
    {
      "type": "simple_column",
      "alias": "cervical_cancer_result",
      "column": "a.cervical_cancer_result"
    },
    {
      "type": "simple_column",
      "alias": "ppfp_method",
      "column": "a.women_received_post_partum_fp"
    },
    {
      "type": "simple_column",
      "alias": "maternal_haart",
      "column": "a.maternal_haart"
    },
    {
      "type": "simple_column",
      "alias": "other_maternal_complications",
      "column": "a.maternal_complications"
    },
    {
      "type": "simple_column",
      "alias": "haemanitics",
      "column": "a.haemanitics"
    },

    {
      "type": "simple_column",
      "alias": "referral_from",
      "column": "a.referred_from"
    },
    {
      "type": "simple_column",
      "alias": "referral_to",
      "column": "a.referred_to"
    },
    {
      "type": "derived_column",
      "alias": "reason_for_referral",
      "column": "a.reason_for_referral"
    },
    {
      "type": "derived_column",
      "alias": "remarks",
      "column": "a.remarks"
    }
  ],
  "groupBy": {
    "columns": ["a.person_id"]
  },
  "filters": {
    "conditionJoinOperator": "and",
    "conditions": [
      {
        "filterType": "tableColumns",
        "conditionExpression": "a.encounter_type in (266, 267)"
      }
    ]
  },
  "orderBy": {
    "orderByParam": "orderByParam",
    "columns": [
      {
        "column": "a.encounter_datetime",
        "order": "asc"
      }
    ]
  }
}
