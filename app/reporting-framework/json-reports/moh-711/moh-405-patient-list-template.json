      "column": "a.reason_for_referral"
    },
    {
      "type": "simple_column",
      "alias": "remarks",
      "column": "a.remarks"
    }
  ],
  "groupBy": {
    "columns": ["a.person_id"]
  },
  "orderBy": {
    "orderByParam": "orderByParam",
    "columns": [
      {
        "column": "a.encounter_datetime",
        "order": "asc"
      }
    ]
  }
}
