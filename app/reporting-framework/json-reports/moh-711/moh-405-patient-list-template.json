{
  "name": "moh_405_patient_list_template",
  "version": "1.0",
  "tag": "moh_405_patient_list_template",
  "description": "moh_405_patient_list_template",
  "uses": [
    {
      "name": "ancBase",
      "version": "1.0",
      "type": "dataset_def"
    }
  ],
  "sources": [
    {
      "dataSet": "ancBase",
      "alias": "a"
    },
    {
      "table": "amrs.person",
      "alias": "pn",
      "join": {
        "type": "INNER",
        "joinCondition": "pn.person_id = a.person_id"
      }
    },
    {
      "table": "amrs.patient_identifier",
      "alias": "anc_number",
      "join": {
        "type": "LEFT",
        "joinCondition": "anc_number.patient_id = a.person_id AND anc_number.identifier_type = 8"
      }
    },
    {
      "table": "amrs.patient_identifier",
      "alias": "nupi",
      "join": {
        "type": "LEFT",
        "joinCondition": "nupi.patient_id = a.person_id AND nupi.identifier_type = 55"
      }
    },
    {
      "table": "amrs.person_name",
      "alias": "person_name",
      "join": {
        "type": "INNER",
        "joinCondition": "a.person_id = person_name.person_id AND (person_name.voided IS NULL OR person_name.voided = 0) AND person_name.preferred = 1"
      }
    },
    {
      "table": "amrs.person_attribute",
      "alias": "attribute",
      "join": {
        "type": "LEFT",
        "joinCondition": "attribute.person_id = a.person_id AND attribute.person_attribute_type_id = 10"
      }
    },
    {
      "table": "amrs.patient_identifier",
      "alias": "amrs",
      "join": {
        "type": "LEFT",
        "joinCondition": "a.person_id = amrs.patient_id AND (amrs.voided IS NULL OR amrs.voided = 0) AND amrs.identifier_type = 8"
      }
    },
    {
      "table": "amrs.person_address",
      "alias": "pa",
      "join": {
        "type": "LEFT",
        "joinCondition": "a.person_id = pa.person_id"
      }
    }
  ],
  "columns": [
    {
      "type": "simple_column",
      "alias": "patient_uuid",
      "column": "pn.uuid"
    },
    {
      "type": "simple_column",
      "alias": "person_id",
      "column": "a.person_id"
    },
    {
      "type": "simple_column",
      "alias": "date_of_visit",
      "column": "a.encounter_datetime"
    },
    {
      "type": "simple_column",
      "alias": "anc_number",
      "column": "anc_number.identifier"
    },
    {
      "type": "simple_column",
      "alias": "nupi",
      "column": "nupi.identifier"
    },
    {
      "type": "simple_column",
      "alias": "amrs_id",
      "column": "amrs.identifier"
    },
    {
      "type": "simple_column",
      "alias": "number_of_anc_visits",
      "column": "a.anc_visit_number"
    },
    {
      "type": "derived_column",
      "alias": "full_name",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "CONCAT_WS(' ', COALESCE(person_name.given_name, ''), COALESCE(person_name.middle_name, ''), COALESCE(person_name.family_name, ''))"
      }
    },
    {
      "type": "simple_column",
      "alias": "date_of_birth",
      "column": "pn.birthdate"
    },
    {
      "type": "simple_column",
      "alias": "age",
      "column": "a.age"
    },
    {
      "type": "simple_column",
      "alias": "county_sub_county",
      "column": "pa.county_district"
    },
    {
      "type": "simple_column",
      "alias": "village_estate_landmark",
      "column": "pa.city_village"
    },
    {
      "type": "simple_column",
      "alias": "phone_number",
      "column": "attribute.value"
    },
    {
      "type": "simple_column",
      "alias": "marital_status",
      "column": "a.marital_status"
    },
    {
      "type": "simple_column",
      "alias": "parity",
      "column": "a.parity"
    },
    {
      "type": "simple_column",
      "alias": "gravidae",
      "column": "a.gravidae"
    },
    {
      "type": "simple_column",
      "alias": "last_lmp_date",
      "column": "a.last_lmp_date"
    },
    {
      "type": "simple_column",
      "alias": "edd",
      "column": "a.edd"
    },
    {
      "type": "simple_column",
      "alias": "gestation_in_weeks",
      "column": "a.gestation_in_weeks"
    },
    {
      "type": "simple_column",
      "alias": "muac",
      "column": "a.muac"
    },
    {
      "type": "simple_column",
      "alias": "height",
      "column": "a.height"
    },
    {
      "type": "simple_column",
      "alias": "weight",
      "column": "a.weight"
    },
    {
      "type": "derived_column",
      "alias": "blood_pressure",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "CONCAT_WS('/', a.bp_systolic, a.bp_diastolic)"
      }
    },
    {
      "type": "simple_column",
      "alias": "breast_exam",
      "column": "a.breast_exam"
    },
    {
      "type": "simple_column",
      "alias": "fgm",
      "column": "null"
    },
    {
      "type": "simple_column",
      "alias": "fgm_complications",
      "column": "a.delivery_complications"
    },
    {
      "type": "simple_column",
      "alias": "haemoglobin",
      "column": "a.haemoglobin"
    },
    {
      "type": "simple_column",
      "alias": "blood_sugar_test",
      "column": "a.blood_sugar_test"
    },
    {
      "type": "simple_column",
      "alias": "blood_group_status",
      "column": "a.blood_group_status"
    },
    {
      "type": "simple_column",
      "alias": "urinalysis",
      "column": "a.urinalysis"
    },
    {
      "type": "simple_column",
      "alias": "rpr_vdrl_duo",
      "column": "a.rpr_vdrl_duo"
    },
    {
      "type": "simple_column",
      "alias": "rpr_vdrl_duo_results",
      "column": "a.rpr_vdrl_duo_results"
    },
    {
      "type": "simple_column",
      "alias": "hepatitisB",
      "column": "a.hepatitisB"
    },
    {
      "type": "simple_column",
      "alias": "hepatitisB_treatment",
      "column": "a.hepatitisB_treatment"
    },
    {
      "type": "simple_column",
      "alias": "tb_screening",
      "column": "a.tb_screening"
    },
    {
      "type": "simple_column",
      "alias": "hiv_test_type",
      "column": "a.hiv_test_type"
    },
    {
      "type": "simple_column",
      "alias": "hiv_test_1_kit_name",
      "column": "a.hiv_test_1_kit_name"
    },
    {
      "type": "simple_column",
      "alias": "hiv_test_1_lot_no",
      "column": "a.hiv_test_1_lot_no"
    },
    {
      "type": "simple_column",
      "alias": "hiv_test_1_expiry_date",
