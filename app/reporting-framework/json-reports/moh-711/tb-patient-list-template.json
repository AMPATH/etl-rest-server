{
  "name": "tb_patient_list_template",
  "version": "1.0",
  "tag": "tb_patient_list_template",
  "description": "TB Patient list template",
  "uses": [
    {
      "name": "tbScreeningBase",
      "version": "1.0",
      "type": "dataset_def"
    }
  ],
  "sources": [
    {
      "dataSet": "tbScreeningBase",
      "alias": "a"
    },
    {
      "table": "amrs.person",
      "alias": "pn",
      "join": {
        "type": "INNER",
        "joinCondition": "pn.person_id = a.person_id"
      }
    },
    {
      "table": "amrs.patient_identifier",
      "alias": "cr_id",
      "join": {
        "type": "LEFT",
        "joinCondition": "cr_id.patient_id = a.person_id AND cr_id.identifier_type = 55"
      }
    },
    {
      "table": "amrs.patient_identifier",
      "alias": "nupi",
      "join": {
        "type": "LEFT",
        "joinCondition": "nupi.patient_id = a.person_id AND nupi.identifier_type = 45"
      }
    },
    {
      "table": "amrs.person_name",
      "alias": "person_name",
      "join": {
        "type": "INNER",
        "joinCondition": "a.person_id = person_name.person_id AND (person_name.voided IS NULL || person_name.voided = 0) AND person_name.preferred = 1"
      }
    },
    {
      "table": "amrs.person_attribute",
      "alias": "attribute",
      "join": {
        "type": "LEFT",
        "joinCondition": "attribute.person_id = a.person_id AND attribute.person_attribute_type_id = 10"
      }
    },
    {
      "table": "amrs.patient_identifier",
      "alias": "amrs",
      "join": {
        "type": "LEFT",
        "joinCondition": "a.person_id = amrs.patient_id AND (amrs.voided IS NULL || amrs.voided = 0) AND amrs.identifier_type = 8"
      }
    },
    {
      "table": "amrs.person_address",
      "alias": "pa",
      "join": {
        "type": "LEFT",
        "joinCondition": "a.person_id = pa.person_id"
      }
    }
  ],
  "columns": [
    {
      "type": "simple_column",
      "alias": "person_id",
      "column": "a.person_id"
    },
    {
      "type": "simple_column",
      "alias": "encounter_type",
      "column": "a.encounter_type"
    },
    {
      "type": "simple_column",
      "alias": "encounter_id",
      "column": "a.encounter_id"
    },
    {
      "type": "simple_column",
      "alias": "date",
      "column": "a.encounter_datetime"
    },
    {
      "type": "simple_column",
      "alias": "amrs_id",
      "column": "amrs.identifier"
    },
    {
      "type": "simple_column",
      "alias": "cr_id",
      "column": "cr_id.identifier"
    },
    {
      "type": "simple_column",
      "alias": "nupi",
      "column": "nupi.identifier"
    },
    {
      "type": "derived_column",
      "alias": "name_of_client",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": " CONCAT_WS(' ', COALESCE(person_name.given_name, ''), COALESCE(person_name.middle_name, ''), COALESCE(person_name.family_name, ''))"
      }
    },
    {
      "type": "simple_column",
      "alias": "date_of_birth",
      "column": "pn.birthdate"
    },
    {
      "type": "simple_column",
      "alias": "age",
      "column": "a.age"
    },
    {
      "type": "simple_column",
      "alias": "county_sub_county",
      "column": "pa.county_district"
    },
    {
      "type": "simple_column",
      "alias": "village_estate_landmark",
      "column": "pa.city_village"
    },
    {
      "type": "simple_column",
      "alias": "tb_screening",
      "column": "t.tb_screening"
    },
    {
      "type": "simple_column",
      "alias": "tb_status",
      "column": "t.tb_status"
    },
    {
      "type": "simple_column",
      "alias": "rtc",
      "column": "t.rtc"
    }
  ],
  "groupBy": {
    "columns": ["a.person_id"]
  },
  "orderBy": {
    "orderByParam": "orderByParam",
    "columns": [
      {
        "column": "a.encounter_datetime",
        "order": "asc"
      }
    ]
  }
}
