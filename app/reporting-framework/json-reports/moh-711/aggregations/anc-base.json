      }
    },
    {
      "type": "derived_column",
      "alias": "anc_clients_tested_syphilis",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "if(m.anc_clients_tested_syphilis = 1, 1, NULL)"
      }
    },
    {
      "type": "derived_column",
      "alias": "syphilis_positive",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "if(m.syphilis_positive = 1, 1, NULL)"
      }
    },
    {
      "type": "derived_column",
      "alias": "breast_exam",
