      "expressionOptions": {
        "expression": "m.breast_exam"
      }
    },
    {
      "type": "derived_column",
      "alias": "adolesc_10_14",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "IF(m.age BETWEEN 10 AND 14 AND m.encounter_type = 265, 1, 0)"
      }
    },
    {
      "type": "derived_column",
      "alias": "adolesc_15_19",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "IF(m.age BETWEEN 15 AND 19 AND m.encounter_type = 265, 1, 0)"
      }
    },
    {
      "type": "derived_column",
      "alias": "youth_20_24",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "if(m.age BETWEEN 20 AND 24 AND m.encounter_type = 265, 1, NULL)"
      }
    },
    {
      "type": "derived_column",
      "alias": "iron",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "if(m.iron = 1 AND (m.folic IS NULL OR m.folic != 1) AND (m.iron_and_folate IS NULL OR m.iron_and_folate != 1), 1, NULL)"
      }
    },
    {
      "type": "derived_column",
      "alias": "folic",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "if(m.folic = 1 AND (m.iron IS NULL OR m.iron != 1) AND (m.iron_and_folate IS NULL OR m.iron_and_folate != 1), 1, NULL)"
      }
    },
    {
      "type": "derived_column",
      "alias": "iron_and_folate",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "if(m.iron_and_folate = 1 OR (m.iron = 1 AND m.folic = 1), 1, NULL)"
      }
    },
    {
      "type": "derived_column",
      "alias": "fgm_complications",
