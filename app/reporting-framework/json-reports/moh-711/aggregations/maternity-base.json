      "column": "m.chlorhexidine_applied"
    },

    {
      "type": "simple_column",
      "alias": "vitamin_k",
      "column": "m.vitamin_k"
    },
    {
      "type": "simple_column",
      "alias": "tetracycline_given",
      "column": "m.tetracycline_given"
    },
    {
      "type": "simple_column",
      "alias": "pre_term_babies",
      "column": "m.pre_term_babies"
    },

    {
      "type": "simple_column",
      "alias": "discharge_alive",
      "column": "m.discharge_alive"
    },

    {
      "type": "simple_column",
      "alias": "bf_within_1_hour",
      "column": "m.bf_within_1_hour"
