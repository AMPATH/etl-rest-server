    },

    {
      "type": "simple_column",
      "alias": "macerated_still_birth",
      "column": "m.macerated_still_birth"
    },

    {
      "type": "derived_column",
      "alias": "perinatal_deaths_0_7_days",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "null"
      }
    },
    {
      "type": "derived_column",
      "alias": "neonatal_deaths_0_28_days",
