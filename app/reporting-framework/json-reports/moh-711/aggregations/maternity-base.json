        "expression": "null"
      }
    },
    {
      "type": "derived_column",
      "alias": "maternal_deaths_20_24_years",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "null"
      }
    },
    {
      "type": "derived_column",
      "alias": "maternal_deaths_25_above_years",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "null"
      }
    },
    {
      "type": "derived_column",
      "alias": "maternal_deaths_audited_within_7_days",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "null"
      }
    },
    {
      "type": "derived_column",
      "alias": "neonatal_deaths_audited_within_7_days",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "null"
      }
    },
    {
      "type": "derived_column",
      "alias": "ante_partum_haemorrage",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "if(m.maternal_complications = 'ante_partum_haemorrage', 1, NULL)"
      }
    },
    {
      "type": "derived_column",
      "alias": "post_partum_haemorrage",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "if(m.maternal_complications = 'post_partum_haemorrage', 1, NULL)"
      }
    },
    {
      "type": "derived_column",
      "alias": "eclampsia",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "if(m.maternal_complications = 'eclampsia', 1, NULL)"
      }
    },
    {
      "type": "derived_column",
      "alias": "ruptured_uterus",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "if(m.maternal_complications = 'ruptured_uterus', 1, NULL)"
      }
    },
    {
      "type": "derived_column",
      "alias": "obstructed_labour",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "if(m.maternal_complications = 'obstructed_labour', 1, NULL)"
      }
    },
    {
