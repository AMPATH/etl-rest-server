      }
    },
    {
      "type": "derived_column",
      "alias": "fgm_delivery_complications",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "if(m.maternal_complications = 'fgm_delivery_complications', 1, NULL)"
      }
    },
    {
      "type": "derived_column",
      "alias": "neonatal_deaths_sepsis",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "if(m.neonatal_death = 'sepsis', 1, NULL)"
      }
    },
    {
      "type": "derived_column",
      "alias": "neonatal_deaths_prematurity",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "if(m.neonatal_death = 'prematurity', 1, NULL)"
      }
    },
    {
      "type": "derived_column",
      "alias": "neonatal_deaths_asphyxia",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "if(m.neonatal_death = 'asphyxia', 1, NULL)"
      }
    },
    {
      "type": "simple_column",
      "alias": "kangaroo_mother_care",
      "column": "m.kangaroo_mother_care"
    },
    {
      "type": "simple_column",
      "alias": "referrals_from_other_health_facility",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "if(m.referred_from = 'HEALTH FACILITY', 1, NULL)"
      }
    },
    {
      "type": "simple_column",
      "alias": "referrals_to_other_health_facility",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "if(m.referred_to = 'HEALTH FACILITY', 1, NULL)"
      }
    },
    {
      "type": "derived_column",
      "alias": "referrals_from_community",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "if(m.referred_from = 'COMMUNITY', 1, NULL)"
      }
    },
    {
      "type": "derived_column",
      "alias": "referrals_to_community",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "if(m.referred_to = 'COMMUNITY', 1, NULL)"
      }
    }
  ],
  "filters": {
    "conditionJoinOperator": "and",
    "conditions": [
      {
        "filterType": "tableColumns",
        "conditionExpression": "m.encounter_type in (196, 274, 273, 269)"
      },
      {
        "filterType": "tableColumns",
        "conditionExpression": "m.encounter_datetime >= ?",
        "parameterName": "startDate"
      },
      {
        "filterType": "tableColumns",
        "conditionExpression": "m.encounter_datetime <= ?",
        "parameterName": "endDate"
      },
      {
        "filterType": "tableColumns",
        "conditionExpression": "m.location_id in ?",
        "parameterName": "locations"
      }
    ]
  },
  "groupBy": {
    "groupParam": "groupByParam",
    "columns": ["m.person_id", "m.encounter_datetime"]
  }
}
