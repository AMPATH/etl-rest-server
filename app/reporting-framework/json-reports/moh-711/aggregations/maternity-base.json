{
  "name": "maternityBase",
  "version": "1.0",
  "tag": "",
  "description": "",
  "uses": [],
  "sources": [
    {
      "table": "etl.flat_moh_711",
      "alias": "m"
    },
    {
      "table": "amrs.encounter",
      "alias": "e",
      "join": {
        "type": "INNER",
        "joinCondition": "e.encounter_id = m.encounter_id AND e.voided = 0"
      }
    },
    {
      "table": "etl.flat_patient_identifiers_v1",
      "alias": "flat_identifiers",
      "join": {
        "type": "LEFT",
        "joinCondition": "m.person_id = flat_identifiers.patient_id"
      }
    },
    {
      "table": "amrs.person",
      "alias": "p",
      "join": {
        "type": "INNER",
        "joinCondition": "m.person_id = p.person_id AND p.voided = 0"
      }
    }
  ],
  "columns": [
    {
      "type": "simple_column",
      "alias": "person_id",
      "column": "m.person_id"
    },
    {
      "type": "simple_column",
      "alias": "ccc_number",
      "column": "flat_identifiers.ccc"
    },
    {
      "type": "simple_column",
      "alias": "upi_number",
      "column": "flat_identifiers.nupi"
    },
    {
      "type": "simple_column",
      "alias": "encounter_datetime",
      "column": "m.encounter_datetime"
    },
    {
      "type": "simple_column",
      "alias": "location_id",
      "column": "m.location_id"
    },
    {
      "type": "simple_column",
      "alias": "normal_deliveries",
      "column": "m.normal_deliveries"
    },
    {
      "type": "simple_column",
      "alias": "caesarian_sections",
      "column": "m.caesarian_sections"
    },
    {
      "type": "simple_column",
      "alias": "breach_delivery",
      "column": "m.breach_delivery"
    },

    {
      "type": "simple_column",
      "alias": "assisted_vaginal_delivery",
      "column": "m.assisted_vaginal_delivery"
    },

    {
      "type": "simple_column",
      "alias": "oxytocin_uterotonic",
      "column": "m.oxytocin_uterotonic"
    },

    {
      "type": "simple_column",
      "alias": "carbatocin_uterotonic",
      "column": "m.carbatocin_uterotonic"
    },

    {
      "type": "simple_column",
      "alias": "live_birth",
      "column": "m.live_birth"
    },

    {
      "type": "derived_column",
      "alias": "low_birth_weight",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "if(m.child_birth_weight < 2500, 1, NULL)"
      }
    },
    {
      "type": "derived_column",
      "alias": "low_apgar_score",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "if(m.apgar_score <= 6, 1, NULL)"
      }
    },
    {
      "type": "simple_column",
      "alias": "birth_with_deformity",
      "column": "m.birth_with_deformity"
    },
    {
      "type": "simple_column",
