{
  "name": "tbScreeningBase",
  "version": "1.0",
  "tag": "",
  "description": "",
  "uses": [],
  "sources": [
    {
      "table": "etl.flat_moh_711",
      "alias": "t"
    }
  ],
  "columns": [
    {
      "type": "simple_column",
      "alias": "person_id",
      "column": "t.person_id"
    },
    {
      "type": "simple_column",
      "alias": "encounter_datetime",
      "column": "t.encounter_datetime"
    },
    {
      "type": "derived_column",
      "alias": "total_screened_for_tb",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "if(t.tb_screening IS NOT NULL, 1, 0)"
      }
    },
    {
      "type": "derived_column",
      "alias": "total_presumptive_tb_cases",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "if(T.tb_screening = 'Presumed TB', 1, 0)"
      }
    },
    {
      "type": "derived_column",
      "alias": "already_on_tb_treatment",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "if(T.tb_screening = 'On TB treatment', 1, 0)"
      }
    },
    {
      "type": "derived_column",
      "alias": "not_screened_for_tb",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "if(t.tb_screening IS NULL, 1, 0)"
      }
    },
    {
      "type": "simple_column",
      "alias": "tb_screening",
      "column": "t.tb_screening"
    },
    {
      "type": "simple_column",
      "alias": "tb_status",
      "column": "t.tb_status"
    },
    {
      "type": "simple_column",
      "alias": "rtc",
      "column": "t.rtc"
    }
  ],
  "filters": {
    "conditionJoinOperator": "and",
    "conditions": [
      {
        "filterType": "tableColumns",
        "conditionExpression": "t.encounter_datetime >= ?",
        "parameterName": "startDate"
      },
      {
        "filterType": "tableColumns",
        "conditionExpression": "t.encounter_datetime <= ?",
        "parameterName": "endDate"
      },
      {
        "filterType": "tableColumns",
        "conditionExpression": "t.location_id in ?",
        "parameterName": "locations"
      }
    ]
  },
  "groupBy": {
    "groupParam": "groupByParam",
    "columns": ["t.person_id"]
  }
}
