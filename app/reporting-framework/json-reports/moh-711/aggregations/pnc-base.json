{
  "name": "pncBase",
  "version": "1.0",
  "tag": "",
  "description": "",
  "uses": [],
  "sources": [
    {
      "table": "etl.flat_moh_711",
      "alias": "p"
    },
    {
      "table": "etl.flat_patient_identifiers_v1",
      "alias": "flat_identifiers",
      "join": {
        "type": "LEFT",
        "joinCondition": "p.person_id = flat_identifiers.patient_id"
      }
    }
  ],
  "columns": [
    {
      "type": "simple_column",
      "alias": "person_id",
      "column": "p.person_id"
    },
    {
      "type": "simple_column",
      "alias": "location_id",
      "column": "p.location_id"
    },
    {
      "type": "simple_column",
      "alias": "encounter_datetime",
      "column": "p.encounter_datetime"
    },
    {
      "type": "simple_column",
      "alias": "ccc_number",
      "column": "flat_identifiers.ccc"
    },
    {
      "type": "simple_column",
      "alias": "upi_number",
      "column": "flat_identifiers.nupi"
    },
    {
      "type": "derived_column",
      "alias": "pnc_new_clients",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "IF(p.encounter_type = 266, 1, 0)"
      }
    },
    {
      "type": "derived_column",
      "alias": "pnc_revisit_clients",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "IF(p.encounter_type = 267, 1, 0)"
      }
    },
    {
      "type": "simple_column",
      "alias": "women_couselled_on_post_partum_fp",
      "column": "p.women_couselled_on_post_partum_fp"
    },
    {
      "type": "simple_column",
      "alias": "women_received_post_partum_fp",
      "expressionType": "simple_expression",
      "column": "p.women_received_post_partum_fp"
    },
    {
      "type": "derived_column",
      "alias": "mothers_post_partum_care_48_hours",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "if(p.post_partum_timing_mother = '0-48 HOURS', 1, 0)"
      }
    },
    {
      "type": "derived_column",
      "alias": "mothers_post_partum_care_3_6_weeks",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "if(p.post_partum_timing_mother = '3 DAYS TO 6 WEEKS', 1, 0)"
      }
    },
    {
      "type": "derived_column",
      "alias": "mothers_post_partum_care_after_6_weeks",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "if(p.post_partum_timing_mother = 'MORE THAN SIX WEEKS', 1, 0)"
      }
    },
    {
      "type": "derived_column",
      "alias": "infants_post_partum_care_48_hours",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "if(p.post_partum_care_infants = '0-48 HOURS', 1, 0)"
      }
    },
    {
      "type": "derived_column",
      "alias": "infants_post_partum_care_3_6_weeks",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "if(p.post_partum_care_infants = '3 DAYS TO 6 WEEKS', 1, 0)"
      }
    },
    {
      "type": "derived_column",
      "alias": "infants_post_partum_care_after_6_weeks",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "if(p.post_partum_care_infants = 'MORE THAN SIX WEEKS', 1, 0)"
      }
    },
    {
      "type": "derived_column",
      "alias": "fistula_cases",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "if(p.fistula_cases = 1, 1, 0)"
      }
    },
    {
      "type": "derived_column",
      "alias": "referrals_from_community",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "if(p.referred_from = 'COMMUNITY', 1, 0)"
      }
    }
  ],
  "filters": {
    "conditionJoinOperator": "and",
    "conditions": [
      {
        "filterType": "tableColumns",
        "conditionExpression": "p.encounter_type in (266, 267)"
      },
      {
        "filterType": "tableColumns",
        "conditionExpression": "p.encounter_datetime >= ?",
        "parameterName": "startDate"
      },
      {
        "filterType": "tableColumns",
        "conditionExpression": "p.encounter_datetime <= ?",
        "parameterName": "endDate"
      },
      {
        "filterType": "tableColumns",
        "conditionExpression": "p.location_id in ?",
        "parameterName": "locations"
      }
    ]
  },
  "groupBy": {
    "groupParam": "groupByParam",
    "columns": ["p.person_id"]
  }
}
