    },
    {
      "type": "derived_column",
      "alias": "mothers_post_partum_care_48_hours",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "if(p.post_partum_timing_mother = '0-48 HOURS', 1, 0)"
      }
    },
    {
      "type": "derived_column",
      "alias": "mothers_post_partum_care_3_6_weeks",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "if(p.post_partum_timing_mother = '3 DAYS TO 6 WEEKS', 1, 0)"
      }
    },
    {
      "type": "derived_column",
      "alias": "mothers_post_partum_care_after_6_weeks",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "if(p.post_partum_timing_mother = 'MORE THAN SIX WEEKS', 1, 0)"
      }
    },
    {
      "type": "derived_column",
      "alias": "infants_post_partum_care_48_hours",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "if(p.post_partum_care_infants = '0-48 HOURS', 1, 0)"
      }
    },
    {
      "type": "derived_column",
      "alias": "infants_post_partum_care_3_6_weeks",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "if(p.post_partum_care_infants = '3 DAYS TO 6 WEEKS', 1, 0)"
      }
    },
    {
      "type": "derived_column",
      "alias": "infants_post_partum_care_after_6_weeks",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "if(p.post_partum_care_infants = 'MORE THAN SIX WEEKS', 1, 0)"
      }
    },
    {
      "type": "derived_column",
      "alias": "fistula_cases",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "if(p.fistula_cases = 1, 1, 0)"
      }
    },
    {
      "type": "derived_column",
      "alias": "referrals_from_community",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "if(p.referred_from = 'COMMUNITY', 1, 0)"
