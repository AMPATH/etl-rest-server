{
  "name": "moh_407_patient_list_template",
  "version": "1.0",
  "tag": "moh_407_patient_list_template",
  "description": "MOH 407 Patient list template",
  "uses": [
    {
      "name": "chanisBase",
      "version": "1.0",
      "type": "dataset_def"
    }
  ],

  "sources": [
    {
      "table": "etl.flat_moh_711",
      "alias": "a"
    },
    {
      "table": "amrs.person",
      "alias": "pn",
      "join": {
        "type": "INNER",
        "joinCondition": "pn.person_id = a.person_id AND pn.voided = 0"
      }
    },
    {
      "table": "amrs.patient_identifier",
      "alias": "cr_id",
      "join": {
        "type": "LEFT",
        "joinCondition": "cr_id.patient_id = a.person_id AND cr_id.identifier_type = 55 AND cr_id.voided = 0"
      }
    },
    {
      "table": "amrs.patient_identifier",
      "alias": "national_id",
      "join": {
        "type": "LEFT",
        "joinCondition": "national_id.patient_id = a.person_id AND national_id.identifier_type = 5 AND national_id.voided = 0"
      }
    },
    {
      "table": "amrs.patient_identifier",
      "alias": "nupi",
      "join": {
        "type": "LEFT",
        "joinCondition": "nupi.patient_id = a.person_id AND nupi.identifier_type = 45 AND nupi.voided = 0"
      }
    },
    {
      "table": "amrs.person_name",
      "alias": "person_name",
      "join": {
        "type": "INNER",
        "joinCondition": "a.person_id = person_name.person_id AND (person_name.voided IS NULL || person_name.voided = 0) AND person_name.preferred = 1"
      }
    },
    {
      "table": "amrs.person_attribute",
      "alias": "attribute",
      "join": {
        "type": "LEFT",
        "joinCondition": "attribute.person_id = a.person_id AND attribute.person_attribute_type_id = 10"
      }
    },
    {
      "table": "amrs.patient_identifier",
      "alias": "amrs",
      "join": {
        "type": "LEFT",
        "joinCondition": "a.person_id = amrs.patient_id AND (amrs.voided IS NULL || amrs.voided = 0) AND amrs.identifier_type = 8"
      }
    },
    {
      "table": "amrs.person_address",
      "alias": "pa",
      "join": {
        "type": "LEFT",
        "joinCondition": "a.person_id = pa.person_id AND pa.voided = 0"
      }
    }
  ],
  "columns": [
    {
      "type": "simple_column",
      "alias": "person_id",
      "column": "a.person_id"
    },
    {
      "type": "simple_column",
      "alias": "encounter_type",
      "column": "a.encounter_type"
    },
    {
      "type": "simple_column",
      "alias": "date",
      "column": "a.encounter_datetime"
    },
    {
      "type": "simple_column",
      "alias": "amrs_id",
      "column": "amrs.identifier"
    },
    {
      "type": "simple_column",
      "alias": "cr_id",
      "column": "cr_id.identifier"
    },
    {
      "type": "simple_column",
      "alias": "national_identification_number",
      "column": "national_id.identifier"
    },
    {
      "type": "simple_column",
      "alias": "nupi",
      "column": "nupi.identifier"
    },
    {
      "type": "derived_column",
      "alias": "patient_names",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": " CONCAT_WS(' ', COALESCE(person_name.given_name, ''), COALESCE(person_name.middle_name, ''), COALESCE(person_name.family_name, ''))"
      }
    },
    {
      "type": "simple_column",
      "alias": "patient_visit",
      "column": "a.visit_type_nutrition"
    },
    {
      "type": "simple_column",
      "alias": "residence",
      "column": "pa.city_village"
    },
    {
      "type": "simple_column",
      "alias": "sex",
      "column": "pn.gender"
    },
    {
      "type": "simple_column",
      "alias": "date_of_birth",
      "column": "pn.birthdate"
    },
    {
      "type": "simple_column",
      "alias": "height",
      "column": "a.height"
    },
    {
      "type": "simple_column",
      "alias": "weight",
      "column": "a.weight"
    },
    {
      "type": "derived_column",
      "alias": "bp_systolic",
      "column": "a.bp_systolic"
    },
    {
      "type": "derived_column",
      "alias": "bp_diastolic",
      "column": "a.bp_diastolic"
    },
    {
      "type": "simple_column",
      "alias": "age",
      "column": "a.age"
    },
    {
      "type": "simple_column",
      "alias": "age_in_months",
      "column": "a.age_in_months"
    },
    {
      "type": "simple_column",
      "alias": "age_in_years",
      "column": "a.age"
    },
    {
      "type": "simple_column",
      "alias": "pregnant_or_breastfeeding",
      "column": "a.pregnant_breastfeeding"
    },
    {
      "type": "simple_column",
      "alias": "z_score",
      "column": "null"
    },
    {
      "type": "simple_column",
      "alias": "nutrition_status",
      "column": "a.nutrition_status"
    },
    {
      "type": "simple_column",
      "alias": "serostatus",
      "column": "a.serostatus"
    },
    {
      "type": "simple_column",
      "alias": "medical_condition",
      "column": "a.medical_conditions"
    },
    {
      "type": "simple_column",
      "alias": "food_secure",
      "column": "a.food_secure"
    },
    {
      "type": "simple_column",
      "alias": "nutrition_intervention",
      "column": "a.supplimental_foods"
    },
    {
      "type": "simple_column",
      "alias": "nutrition_outcome",
      "column": "a.nutrition_outcome"
    },
    {
      "type": "simple_column",
      "alias": "therapeutic_foods",
      "column": "a.therapeutic_foods"
    },
    {
      "type": "simple_column",
      "alias": "nutrition_micronutrients",
      "column": "a.nutrition_micronutrients"
    },
    {
      "type": "simple_column",
      "alias": "admission_criteria",
      "column": "a.admission_criteria"
    },
    {
      "type": "simple_column",
      "alias": "type_of_admission",
      "column": "a.type_of_admission"
    },
    {
      "type": "simple_column",
      "alias": "cadre",
      "column": "a.cadre"
    },
    {
      "type": "simple_column",
      "alias": "serostatus",
      "column": "a.serostatus"
    },
    {
      "type": "simple_column",
      "alias": "nutrition_status",
      "column": "a.nutrition_status"
    },
    {
      "type": "simple_column",
      "alias": "z_score",
      "column": "a.weight_for_age OR a.weight_for_height OR a.height_for_age"
    },
    {
      "type": "simple_column",
      "alias": "remarks",
      "column": "a.remarks"
    }
  ],
  "groupBy": {
    "columns": ["a.person_id"]
  },
  "orderBy": {
    "orderByParam": "orderByParam",
    "columns": [
      {
        "column": "a.encounter_datetime",
        "order": "asc"
      }
    ]
  }
}
