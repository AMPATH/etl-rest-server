{
  "name": "specialServicesBase",
  "version": "1.0",
  "tag": "",
  "description": "",
  "uses": [],
  "sources": [
    {
      "table": "amrs.encounter",
      "alias": "e"
    },
    {
      "table": "amrs.person",
      "alias": "p",
      "join": {
        "type": "INNER",
        "joinCondition": "e.patient_id = p.person_id AND p.voided = 0"
      }
    },
    {
      "table": "amrs.location",
      "alias": "l",
      "join": {
        "type": "INNER",
        "joinCondition": "l.location_id = e.location_id"
      }
    }
  ],
  "columns": [
    {
      "type": "simple_column",
      "alias": "obs_datetime",
      "column": "e.encounter_datetime"
    },
    {
      "type": "simple_column",
      "alias": "person_id",
      "column": "e.patient_id"
    },
    {
      "type": "simple_column",
      "alias": "lab_routine_test",
      "column": "(SELECT COUNT(DISTINCT ord.order_id) FROM amrs.orders ord WHERE ord.encounter_id = e.encounter_id AND ord.order_type_id = 3 AND ord.concept_id IN (21,32,45,299,300,302,305,653,654,655,717,848,856,887,1132,1133,1134,1297,1322,1325,1524,1525,1526,1984,1985,2311,2339,2340,6124,6132,6337,6709,7276,7880,7881,7882,9187,9307,9812,10627,11868,12019,12078,12875,12880,12881,15084,15086,49547,53247,53269,53270,53309) AND ord.fulfiller_status = 'COMPLETED' AND ord.voided = 0)"
    },
    {
      "type": "simple_column",
      "alias": "lab_special_test",
      "column": "(SELECT COUNT(DISTINCT ord.order_id) FROM amrs.orders ord WHERE ord.encounter_id = e.encounter_id AND ord.order_type_id = 3 AND ord.concept_id IN (785,790,857,1005,1006,1008,1009,1010,1019,1032,1327,6902,7190,9008,10051,10249,10250,10251,10570,15092,49245,53248,53249,53250,53279,53280,53281,53282,53283,53284,53285,53286,53287,53288,53289,53290,53291,53292,53293,53294,53295,53296,53297,53298,53299,53300,53301,53302,53303,53304,53305,53306,53307,53311,53312,53313,53314,53315,53316) AND ord.fulfiller_status = 'COMPLETED' AND ord.voided = 0)"
    },
    {
      "type": "simple_column",
      "alias": "plain_xray_without_enhancement",
      "column": "null"
    },
    {
      "type": "simple_column",
      "alias": "contrast_enhancement_examination",
      "column": "null"
    },
    {
      "type": "simple_column",
      "alias": "magnetic_resonance_imaging",
      "column": "null"
    },
    {
      "type": "simple_column",
      "alias": "computerized_tomography",
      "column": "null"
    },
    {
      "type": "simple_column",
      "alias": "mammography",
      "column": "null"
    },
    {
      "type": "simple_column",
      "alias": "chest_xray_for_ptb",
      "column": "null"
    },
    {
      "type": "simple_column",
      "alias": "number_of_ultrasound_examinations",
      "column": "null"
    },
    {
      "type": "simple_column",
      "alias": "general_ultrasound",
      "column": "null"
    },
    {
      "type": "simple_column",
      "alias": "obstetric_ultrasound",
      "column": "(SELECT COUNT(DISTINCT o.order_id) FROM amrs.orders o WHERE o.encounter_id = e.encounter_id AND o.order_type_id = 4 AND o.concept_id IN (6221) AND o.fulfiller_status = 'COMPLETED' AND o.voided = 0)"
    },
    {
      "type": "simple_column",
      "alias": "total_routine_xray_and_imaging",
      "column": "null"
    },
    {
      "type": "simple_column",
      "alias": "total_special_exams_xray_and_imaging",
      "column": "null"
    },
    {
      "type": "simple_column",
      "alias": "physiotherapy_number_of_treatments",
      "column": "null"
    },
    {
      "type": "simple_column",
      "alias": "occupational_therapy_number_of_treatments",
      "column": "null"
    },
    {
      "type": "simple_column",
      "alias": "orthopaedic_technology_prepared",
      "column": "null"
    },
    {
      "type": "simple_column",
      "alias": "orthopaedic_technology_issued",
      "column": "null"
    }
  ],
  "filters": {
    "conditionJoinOperator": "and",
    "conditions": [
      {
        "filterType": "tableColumns",
        "conditionExpression": "e.encounter_datetime >= ?",
        "parameterName": "startDate"
      },
      {
        "filterType": "tableColumns",
        "conditionExpression": "e.encounter_datetime <= ?",
        "parameterName": "endDate"
      },
      {
        "filterType": "tableColumns",
        "conditionExpression": "e.location_id in ?",
        "parameterName": "locations"
      }
    ]
  },
  "groupBy": {
    "groupParam": "groupByParam",
    "columns": ["e.encounter_id"]
  }
}
