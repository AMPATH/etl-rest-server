{
  "name": "moh505ReportBase",
  "version": "1.0",
  "tag": "",
  "description": "Base dataset for the MOH 505 IDSR weekly report over the encounter-grain etl.flat_moh_505_weekly_v2 table (raw facts + 0/1 indicator flags only; one row per year_week/person/encounter, written by generate_moh_505_weekly_report_v2). Age-band aggregation lives in aggregations/moh-505-report-disaggregation.json; the MOH 240 register presentation lives in moh-505-patient-list-template.json. endDate filter widens to < DATE_ADD(endDate, INTERVAL 1 DAY) - encounter_datetime is a DATETIME and the routes send date-only params, so a plain <= endDate collapsed same-day windows to midnight-only matches (lab706Base v2.6 precedent). age_range is a case_statement column so patient-list drill-downs can filter it directly (the query generator expands case columns into the WHERE clause). Indicator flags are unscoped by encounter type by design for now - generate_moh_505_weekly_report_v2 joins flat_obs without an encounter_type IN (...) filter (owner decision 2026-11); revisit once the IDSR form's encounter types are pinned.",
  "uses": [],
  "sources": [
    {
      "table": "etl.flat_moh_505_weekly_v2",
      "alias": "fm"
    }
  ],
  "columns": [
    {
      "type": "simple_column",
      "alias": "person_uuid",
      "column": "fm.person_uuid"
    },
    {
      "type": "simple_column",
      "alias": "person_id",
      "column": "fm.person_id"
    },
    {
      "type": "simple_column",
      "alias": "encounter_id",
      "column": "fm.encounter_id"
    },
    {
      "type": "simple_column",
      "alias": "encounter_datetime",
      "column": "fm.encounter_datetime"
    },
    {
      "type": "simple_column",
      "alias": "location_id",
      "column": "fm.location_id"
    },
    {
      "type": "simple_column",
      "alias": "year_week",
      "column": "fm.year_week"
    },
    {
      "type": "simple_column",
      "alias": "age",
      "column": "fm.age"
    },
    {
      "type": "simple_column",
      "alias": "gender",
      "column": "fm.gender"
    },
    {
      "type": "simple_column",
      "alias": "aefi",
      "column": "fm.aefi"
    },
    {
      "type": "simple_column",
      "alias": "acute_jaundice",
      "column": "fm.acute_jaundice"
    },
    {
      "type": "simple_column",
      "alias": "acute_malnutrition",
      "column": "fm.acute_malnutrition"
    },
    {
      "type": "simple_column",
      "alias": "anthrax",
      "column": "fm.anthrax"
    },
    {
      "type": "simple_column",
      "alias": "cholera",
      "column": "fm.cholera"
    },
    {
      "type": "simple_column",
      "alias": "dengue",
      "column": "fm.dengue"
    },
    {
      "type": "simple_column",
      "alias": "dysentery_bacillary",
      "column": "fm.dysentery_bacillary"
    },
    {
      "type": "simple_column",
      "alias": "measles",
      "column": "fm.measles"
    },
    {
      "type": "simple_column",
      "alias": "maternal_deaths",
      "column": "fm.maternal_deaths"
    },
    {
      "type": "simple_column",
      "alias": "neonatal_deaths",
      "column": "fm.neonatal_deaths"
    },
    {
      "type": "simple_column",
      "alias": "neonatal_tetanus",
      "column": "fm.neonatal_tetanus"
    },
    {
      "type": "simple_column",
      "alias": "plague",
      "column": "fm.plague"
    },
    {
      "type": "simple_column",
      "alias": "rabies",
      "column": "fm.rabies"
    },
    {
      "type": "simple_column",
      "alias": "typhoid",
      "column": "fm.typhoid"
    },
    {
      "type": "simple_column",
      "alias": "yellow_fever",
      "column": "fm.yellow_fever"
    },
    {
      "type": "simple_column",
      "alias": "malaria_microscopy_tested",
      "column": "fm.malaria_microscopy_tested"
    },
    {
      "type": "simple_column",
      "alias": "malaria_microscopy_positive",
      "column": "fm.malaria_microscopy_positive"
    },
    {
      "type": "simple_column",
      "alias": "malaria_mrdt_tested",
      "column": "fm.malaria_mrdt_tested"
    },
    {
      "type": "simple_column",
      "alias": "malaria_mrdt_positive",
      "column": "fm.malaria_mrdt_positive"
    },
    {
      "type": "simple_column",
      "alias": "bacterial_meningitis",
      "column": "fm.bacterial_meningitis"
    },
    {
      "type": "simple_column",
      "alias": "meningitis_no_csf",
      "column": "fm.meningitis_no_csf"
    },
    {
      "type": "simple_column",
      "alias": "typhoid_lab_tested",
      "column": "fm.typhoid_lab_tested"
    },
    {
      "type": "simple_column",
      "alias": "typhoid_lab_positive",
      "column": "fm.typhoid_lab_positive"
    },
    {
      "type": "derived_column",
      "alias": "age_range",
      "expressionType": "case_statement",
      "expressionOptions": {
        "caseOptions": [
          {
            "condition": "fm.age < 5",
            "value": "0_to_4"
          },
          {
            "condition": "fm.age >= 5",
            "value": "5_and_above"
          }
        ]
      }
    }
  ],
  "filters": {
    "conditionJoinOperator": "and",
    "conditions": [
      {
        "filterType": "tableColumns",
        "conditionExpression": "fm.encounter_datetime >= ?",
        "parameterName": "startDate"
      },
      {
        "filterType": "tableColumns",
        "conditionExpression": "fm.encounter_datetime < DATE_ADD(?, INTERVAL 1 DAY)",
        "parameterName": "endDate"
      },
      {
        "filterType": "tableColumns",
        "conditionExpression": "fm.location_id in ?",
        "parameterName": "locations"
      }
    ]
  }
}
