      "type": "simple_column",
      "alias": "location_id",
      "column": "b.location_id"
    },
    {
      "type": "simple_column",
      "alias": "age_range",
      "column": "b.age_range"
    },
    {
      "type": "derived_column",
      "alias": "aefi",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "COUNT(DISTINCT CASE WHEN b.aefi > 0 THEN b.person_id END)"
      }
    },
    {
      "type": "derived_column",
      "alias": "acute_jaundice",
      "expressionType": "simple_expression",
