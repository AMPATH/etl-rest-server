{
  "name": "presumptiveTbEncounters",
  "version": "1.0",
  "tag": "tb_registers",
  "description": "Presumptive TB Register (MOH/REG/DNTLDP/02), step 1: one row per TB encounter (331) at the locations in the period, with its obs pivoted -- referred by (6749), smear method (9044) and result (307), smear and culture dates (10752 in groups 10750 / 10753), chest X-ray (12), culture (10742), resistance (10754), TB type (2225) and treatment start (1113).",
  "uses": [],
  "sources": [
    {
      "table": "amrs.encounter",
      "alias": "e"
    },
    {
      "table": "amrs.obs",
      "alias": "o",
      "join": {
        "type": "LEFT",
        "joinCondition": "o.encounter_id = e.encounter_id AND o.voided = 0 AND o.concept_id IN (6749, 9044, 307, 10752, 12, 10742, 10754, 2225, 1113)"
      }
    },
    {
      "table": "amrs.obs",
      "alias": "g",
      "join": {
        "type": "LEFT",
        "joinCondition": "g.obs_id = o.obs_group_id"
      }
    }
  ],
  "columns": [
    {
      "type": "simple_column",
      "alias": "encounter_id",
      "column": "e.encounter_id"
    },
    {
      "type": "simple_column",
      "alias": "patient_id",
      "column": "e.patient_id"
    },
    {
      "type": "derived_column",
      "alias": "enc_date",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "DATE(e.encounter_datetime)"
      }
    },
    {
      "type": "derived_column",
      "alias": "referred_by",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "MAX(CASE WHEN o.concept_id = 6749 THEN CASE o.value_coded WHEN 978 THEN 'SR' WHEN 1862 THEN 'CHV' WHEN 5619 THEN 'Other (HCW)' ELSE 'Other (dept)' END END)"
      }
    },
    {
      "type": "derived_column",
      "alias": "smear_method",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "MAX(CASE WHEN o.concept_id = 9044 THEN CASE o.value_coded WHEN 9046 THEN 'FM' WHEN 9045 THEN 'ZN' END END)"
      }
    },
    {
      "type": "derived_column",
      "alias": "smear_code",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "MAX(CASE WHEN o.concept_id = 307 THEN CASE o.value_coded WHEN 664 THEN '0' WHEN 9047 THEN 'Scanty' WHEN 2301 THEN '+' WHEN 2302 THEN '++' WHEN 2303 THEN '+++' END END)"
      }
    },
    {
      "type": "derived_column",
      "alias": "smear_pos",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "MAX(o.concept_id = 307 AND o.value_coded IN (9047, 2301, 2302, 2303))"
      }
    },
    {
      "type": "derived_column",
      "alias": "smear_neg",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "MAX(o.concept_id = 307 AND o.value_coded = 664)"
      }
    },
    {
      "type": "derived_column",
      "alias": "smear_date",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "MAX(IF(o.concept_id = 10752 AND g.concept_id = 10750, DATE(o.value_datetime), NULL))"
      }
    },
    {
      "type": "derived_column",
      "alias": "xray_code",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "MAX(CASE WHEN o.concept_id = 12 THEN CASE o.value_coded WHEN 1115 THEN 'N' WHEN 10765 THEN 'SG' WHEN 1118 THEN 'ND' ELSE 'AO' END END)"
      }
    },
    {
      "type": "derived_column",
      "alias": "culture_text",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "MAX(CASE WHEN o.concept_id = 10742 THEN CASE o.value_coded WHEN 703 THEN 'Culture: Growth' WHEN 664 THEN 'Culture: No growth' END END)"
      }
    },
    {
      "type": "derived_column",
      "alias": "culture_pos",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "MAX(o.concept_id = 10742 AND o.value_coded = 703)"
      }
    },
    {
      "type": "derived_column",
      "alias": "has_res",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "MAX(o.concept_id = 10754)"
      }
    },
    {
      "type": "derived_column",
      "alias": "resistant_to",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "GROUP_CONCAT(DISTINCT CASE WHEN o.concept_id = 10754 THEN CASE o.value_coded WHEN 767 THEN 'R' WHEN 656 THEN 'H' WHEN 5829 THEN 'Z' WHEN 745 THEN 'E' END END SEPARATOR ',')"
      }
    },
    {
      "type": "derived_column",
      "alias": "culture_date",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "MAX(IF(o.concept_id = 10752 AND g.concept_id = 10753, DATE(o.value_datetime), NULL))"
      }
    },
    {
      "type": "derived_column",
      "alias": "has_tb_type",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "MAX(o.concept_id = 2225)"
      }
    },
    {
      "type": "derived_column",
      "alias": "tx_start",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "MAX(IF(o.concept_id = 1113, DATE(o.value_datetime), NULL))"
      }
    }
  ],
  "filters": {
    "conditionJoinOperator": "and",
    "conditions": [
      {
        "filterType": "tableColumns",
        "conditionExpression": "e.encounter_type = 331"
      },
      {
        "filterType": "tableColumns",
        "conditionExpression": "e.location_id IN ?",
        "parameterName": "locations"
      },
      {
        "filterType": "tableColumns",
        "conditionExpression": "e.voided = 0"
      },
      {
        "filterType": "tableColumns",
        "conditionExpression": "e.encounter_datetime >= ?",
        "parameterName": "startDate"
      },
      {
        "filterType": "tableColumns",
        "conditionExpression": "e.encounter_datetime < DATE_ADD(?, INTERVAL 1 DAY)",
        "parameterName": "endDate"
      }
    ]
  },
  "groupBy": {
    "columns": ["e.encounter_id"]
  }
}
