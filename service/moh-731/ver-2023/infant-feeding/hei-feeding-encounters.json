{
  "name": "moh731V2023HeiFeedingEncounters",
  "version": "1.0",
  "tag": "moh_731_ver_2023",
  "description": "MOH 731 (Ver. July 2023) 2.7 Infant Feeding, step 1: HEI follow-up encounters (115) before the end of the period with the infant's age in months at the visit, the return-to-clinic date (5096) and the feeding method (1151) flags -- EBF 5526, BF 6046, NBF 6945. The return-to-clinic rule (the HAVING of the source query) is applied by the base dataset.",
  "uses": [],
  "sources": [
    {
      "table": "amrs.encounter",
      "alias": "e"
    },
    {
      "table": "amrs.person",
      "alias": "pp",
      "join": {
        "type": "INNER",
        "joinCondition": "pp.person_id = e.patient_id AND pp.voided = 0"
      }
    },
    {
      "table": "amrs.obs",
      "alias": "o",
      "join": {
        "type": "INNER",
        "joinCondition": "o.encounter_id = e.encounter_id AND o.concept_id IN (1151, 5096) AND o.voided = 0"
      }
    }
  ],
  "columns": [
    {
      "type": "simple_column",
      "alias": "encounter_id",
      "column": "e.encounter_id"
    },
    {
      "type": "simple_column",
      "alias": "patient_id",
      "column": "e.patient_id"
    },
    {
      "type": "simple_column",
      "alias": "encounter_datetime",
      "column": "e.encounter_datetime"
    },
    {
      "type": "simple_column",
      "alias": "location_id",
      "column": "e.location_id"
    },
    {
      "type": "simple_column",
      "alias": "encounter_type",
      "column": "e.encounter_type"
    },
    {
      "type": "simple_column",
      "alias": "creator",
      "column": "e.creator"
    },
    {
      "type": "simple_column",
      "alias": "date_created",
      "column": "e.date_created"
    },
    {
      "type": "derived_column",
      "alias": "age_months",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "TIMESTAMPDIFF(MONTH, pp.birthdate, e.encounter_datetime)"
      }
    },
    {
      "type": "derived_column",
      "alias": "rtc_date",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "MAX(CASE WHEN o.concept_id = 5096 THEN o.value_datetime END)"
      }
    },
    {
      "type": "derived_column",
      "alias": "has_ebf",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "COALESCE(MAX(o.concept_id = 1151 AND o.value_coded = 5526), 0)"
      }
    },
    {
      "type": "derived_column",
      "alias": "has_bf",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "COALESCE(MAX(o.concept_id = 1151 AND o.value_coded = 6046), 0)"
      }
    },
    {
      "type": "derived_column",
      "alias": "has_nbf",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "COALESCE(MAX(o.concept_id = 1151 AND o.value_coded = 6945), 0)"
      }
    },
    {
      "type": "derived_column",
      "alias": "has_any",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "COALESCE(MAX(o.concept_id = 1151), 0)"
      }
    }
  ],
  "filters": {
    "conditionJoinOperator": "and",
    "conditions": [
      {
        "filterType": "tableColumns",
        "conditionExpression": "e.location_id IN ?",
        "parameterName": "locations"
      },
      {
        "filterType": "tableColumns",
        "conditionExpression": "e.encounter_type = 115"
      },
      {
        "filterType": "tableColumns",
        "conditionExpression": "e.encounter_datetime < DATE_ADD(?, INTERVAL 1 DAY)",
        "parameterName": "endDate"
      },
      {
        "filterType": "tableColumns",
        "conditionExpression": "e.voided = 0"
      }
    ]
  },
  "groupBy": {
    "columns": ["e.encounter_id"]
  }
}
