{
  "name": "moh731V2023HivTestDays",
  "version": "1.0",
  "tag": "moh_731_ver_2023",
  "description": "MOH 731 (Ver. July 2023) 1.1 HIV Tests, step 2: the qualifying tests (the source query's encounter rules, its HAVING) from the encounter dataset, ranked within each client's day by day_rank, so a client tested more than once on a day -- e.g. two L&D encounters -- counts as one test. The one kept is a positive one if any, else the latest encounter. The base keeps day_rank = 1.",
  "uses": [
    {
      "name": "moh731V2023HivTestEncounters",
      "version": "1.0",
      "type": "dataset_def"
    }
  ],
  "sources": [
    {
      "dataSet": "moh731V2023HivTestEncounters",
      "alias": "b"
    }
  ],
  "columns": [
    {
      "type": "simple_column",
      "alias": "encounter_id",
      "column": "b.encounter_id"
    },
    {
      "type": "simple_column",
      "alias": "patient_id",
      "column": "b.patient_id"
    },
    {
      "type": "simple_column",
      "alias": "encounter_datetime",
      "column": "b.encounter_datetime"
    },
    {
      "type": "simple_column",
      "alias": "location_id",
      "column": "b.location_id"
    },
    {
      "type": "simple_column",
      "alias": "encounter_type",
      "column": "b.encounter_type"
    },
    {
      "type": "simple_column",
      "alias": "creator",
      "column": "b.creator"
    },
    {
      "type": "simple_column",
      "alias": "date_created",
      "column": "b.date_created"
    },
    {
      "type": "simple_column",
      "alias": "service",
      "column": "b.service"
    },
    {
      "type": "simple_column",
      "alias": "res_id",
      "column": "b.res_id"
    },
    {
      "type": "simple_column",
      "alias": "tt_id",
      "column": "b.tt_id"
    },
    {
      "type": "simple_column",
      "alias": "set_id",
      "column": "b.set_id"
    },
    {
      "type": "simple_column",
      "alias": "pop_id",
      "column": "b.pop_id"
    },
    {
      "type": "simple_column",
      "alias": "del_id",
      "column": "b.del_id"
    },
    {
      "type": "simple_column",
      "alias": "proph_val",
      "column": "b.proph_val"
    },
    {
      "type": "simple_column",
      "alias": "drug_obs_id",
      "column": "b.drug_obs_id"
    },
    {
      "type": "simple_column",
      "alias": "has_positive",
      "column": "b.has_positive"
    },
    {
      "type": "simple_column",
      "alias": "has_initial",
      "column": "b.has_initial"
    },
    {
      "type": "simple_column",
      "alias": "has_valid_tt",
      "column": "b.has_valid_tt"
    },
    {
      "type": "simple_column",
      "alias": "has_revisit",
      "column": "b.has_revisit"
    },
    {
      "type": "simple_column",
      "alias": "has_typology",
      "column": "b.has_typology"
    },
    {
      "type": "simple_column",
      "alias": "has_discordant",
      "column": "b.has_discordant"
    },
    {
      "type": "derived_column",
      "alias": "day_rank",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "ROW_NUMBER() OVER (PARTITION BY b.patient_id, DATE(b.encounter_datetime) ORDER BY b.has_positive DESC, b.encounter_datetime DESC, b.encounter_id DESC)"
      }
    }
  ],
  "filters": {
    "conditionJoinOperator": "and",
    "conditions": [
      {
        "filterType": "tableColumns",
        "conditionExpression": "b.res_id IS NOT NULL"
      },
      {
        "filterType": "tableColumns",
        "conditionExpression": "((b.service = 'HTS' AND NOT (b.encounter_type = 297 AND b.has_positive = 1)) OR (b.service = 'Maternity' AND b.has_valid_tt = 1 AND NOT (b.has_initial = 0 AND b.has_positive = 1)) OR (b.service = 'ANC' AND b.tt_id IS NOT NULL AND b.has_revisit = 0) OR (b.service = 'PNC' AND b.tt_id IS NOT NULL))"
      }
    ]
  }
}
