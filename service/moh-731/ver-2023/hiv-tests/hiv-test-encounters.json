{
  "name": "moh731V2023HivTestEncounters",
  "version": "1.0",
  "tag": "moh_731_ver_2023",
  "description": "MOH 731 (Ver. July 2023) 1.1 HIV Tests, step 1: one row per HTS, ANC, Maternity or PNC encounter in the period, with the obs it needs pivoted -- the latest obs_id per concept and flags for the result and test type. The encounter rules (the HAVING of the source query) are applied by moh731V2023HivTestDays, which selects from this one.",
  "uses": [],
  "sources": [
    {
      "table": "amrs.encounter",
      "alias": "e"
    },
    {
      "table": "amrs.obs",
      "alias": "o",
      "join": {
        "type": "LEFT",
        "joinCondition": "o.encounter_id = e.encounter_id AND o.voided = 0 AND o.concept_id IN (1357, 12019, 11873, 9782, 5599, 12251, 1895, 1187)"
      }
    }
  ],
  "columns": [
    {
      "type": "simple_column",
      "alias": "encounter_id",
      "column": "e.encounter_id"
    },
    {
      "type": "simple_column",
      "alias": "patient_id",
      "column": "e.patient_id"
    },
    {
      "type": "simple_column",
      "alias": "encounter_datetime",
      "column": "e.encounter_datetime"
    },
    {
      "type": "simple_column",
      "alias": "location_id",
      "column": "e.location_id"
    },
    {
      "type": "simple_column",
      "alias": "encounter_type",
      "column": "e.encounter_type"
    },
    { "type": "simple_column", "alias": "creator", "column": "e.creator" },
    {
      "type": "simple_column",
      "alias": "date_created",
      "column": "e.date_created"
    },
    {
      "type": "derived_column",
      "alias": "service",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "CASE WHEN e.encounter_type IN (296, 297) THEN 'HTS' WHEN e.encounter_type = 273 THEN 'Maternity' WHEN e.encounter_type IN (264, 265) THEN 'ANC' ELSE 'PNC' END"
      }
    },
    {
      "type": "derived_column",
      "alias": "res_id",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "MAX(CASE WHEN o.concept_id = 1357 THEN o.obs_id END)"
      }
    },
    {
      "type": "derived_column",
      "alias": "tt_id",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "MAX(CASE WHEN o.concept_id = 12019 THEN o.obs_id END)"
      }
    },
    {
      "type": "derived_column",
      "alias": "set_id",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "MAX(CASE WHEN o.concept_id = 11873 THEN o.obs_id END)"
      }
    },
    {
      "type": "derived_column",
      "alias": "pop_id",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "MAX(CASE WHEN o.concept_id = 9782 THEN o.obs_id END)"
      }
    },
    {
      "type": "derived_column",
      "alias": "del_id",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "MAX(CASE WHEN o.concept_id = 5599 THEN o.obs_id END)"
      }
    },
    {
      "type": "derived_column",
      "alias": "proph_val",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "MAX(CASE WHEN o.concept_id = 1895 THEN o.value_coded END)"
      }
    },
    {
      "type": "derived_column",
      "alias": "drug_obs_id",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "MAX(CASE WHEN o.concept_id = 1187 THEN o.obs_id END)"
      }
    },
    {
      "type": "derived_column",
      "alias": "has_positive",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "COALESCE(MAX(o.concept_id = 1357 AND o.value_coded = 703), 0)"
      }
    },
    {
      "type": "derived_column",
      "alias": "has_initial",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "COALESCE(MAX(o.concept_id = 12019 AND o.value_coded = 10434), 0)"
      }
    },
    {
      "type": "derived_column",
      "alias": "has_valid_tt",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "COALESCE(MAX(o.concept_id = 12019 AND o.value_coded IN (10434, 10200)), 0)"
      }
    },
    {
      "type": "derived_column",
      "alias": "has_revisit",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "COALESCE(MAX(o.concept_id = 12019 AND o.value_coded = 10973), 0)"
      }
    },
    {
      "type": "derived_column",
      "alias": "has_typology",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "COALESCE(MAX(o.concept_id = 12251), 0)"
      }
    },
    {
      "type": "derived_column",
      "alias": "has_discordant",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "COALESCE(MAX(o.concept_id = 12251 AND o.value_coded = 6096), 0)"
      }
    }
  ],
  "filters": {
    "conditionJoinOperator": "and",
    "conditions": [
      {
        "filterType": "tableColumns",
        "conditionExpression": "e.location_id IN ?",
        "parameterName": "locations"
      },
      {
        "filterType": "tableColumns",
        "conditionExpression": "e.encounter_type IN (296, 297, 273, 264, 265, 266, 267)"
      },
      {
        "filterType": "tableColumns",
        "conditionExpression": "e.encounter_datetime >= ?",
        "parameterName": "startDate"
      },
      {
        "filterType": "tableColumns",
        "conditionExpression": "e.encounter_datetime < DATE_ADD(?, INTERVAL 1 DAY)",
        "parameterName": "endDate"
      },
      {
        "filterType": "tableColumns",
        "conditionExpression": "e.voided = 0"
      }
    ]
  },
  "groupBy": {
    "columns": ["e.encounter_id"]
  }
}
