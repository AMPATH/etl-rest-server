{
  "name": "moh731V2023HivTestsAggregate",
  "version": "1.0",
  "tag": "moh_731_ver_2023",
  "description": "MOH 731 (Ver. July 2023) 1.1 HIV Tests, HV01-01 to HV01-05: each figure is the number of qualifying tests carrying its flag in the base dataset, 0 when there are none.",
  "uses": [
    {
      "name": "moh731V2023HivTestsBase",
      "version": "1.0",
      "type": "dataset_def"
    }
  ],
  "sources": [
    {
      "dataSet": "moh731V2023HivTestsBase",
      "alias": "hts"
    }
  ],
  "columns": [
    {
      "type": "derived_column",
      "alias": "hiv_male",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "COALESCE(SUM(hts.hiv_male), 0)"
      }
    },
    {
      "type": "derived_column",
      "alias": "hiv_female",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "COALESCE(SUM(hts.hiv_female), 0)"
      }
    },
    {
      "type": "derived_column",
      "alias": "hiv_setting_facility",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "COALESCE(SUM(hts.hiv_setting_facility), 0)"
      }
    },
    {
      "type": "derived_column",
      "alias": "hiv_setting_community",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "COALESCE(SUM(hts.hiv_setting_community), 0)"
      }
    },
    {
      "type": "derived_column",
      "alias": "hiv_setting_kvp",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "COALESCE(SUM(hts.hiv_setting_kvp), 0)"
      }
    }
  ],
  "transFormDirectives": {
    "joinColumn": "location_id",
    "joinColumnParam": "",
    "skipColumns": [""],
    "disaggregationColumns": []
  },
  "dynamicJsonQueryGenerationDirectives": {
    "patientListGenerator": {
      "useTemplate": "moh731V2023HivTestsPatientListTemplate",
      "useTemplateVersion": "1.0",
      "generatingDirectives": {
        "joinDirectives": {
          "joinType": "INNER",
          "joinCondition": "<<base_column>> = <<template_column>>",
          "baseColumn": "patient_id",
          "templateColumn": "person_id"
        }
      }
    }
  }
}
