{
  "name": "moh731V2023AncKnownPositiveEncounters",
  "version": "1.0",
  "tag": "moh_731_ver_2023",
  "description": "MOH 731 (Ver. July 2023) 2.1 Known Positive at 1st ANC, step 1: ANC encounters (Initial 265, Return 264) in the period with their obs pivoted -- ANC visit number (7086), known positive (12019 = 10407), infant prophylaxis (1895) and drug (1187). The known-positive rule (the HAVING of the source query) is applied by the base dataset.",
  "uses": [],
  "sources": [
    {
      "table": "amrs.encounter",
      "alias": "e"
    },
    {
      "table": "amrs.obs",
      "alias": "o",
      "join": {
        "type": "INNER",
        "joinCondition": "o.encounter_id = e.encounter_id AND o.voided = 0 AND o.concept_id IN (7086, 12019, 1895, 1187)"
      }
    }
  ],
  "columns": [
    {
      "type": "simple_column",
      "alias": "encounter_id",
      "column": "e.encounter_id"
    },
    {
      "type": "simple_column",
      "alias": "patient_id",
      "column": "e.patient_id"
    },
    {
      "type": "simple_column",
      "alias": "encounter_datetime",
      "column": "e.encounter_datetime"
    },
    {
      "type": "simple_column",
      "alias": "location_id",
      "column": "e.location_id"
    },
    {
      "type": "simple_column",
      "alias": "encounter_type",
      "column": "e.encounter_type"
    },
    {
      "type": "simple_column",
      "alias": "creator",
      "column": "e.creator"
    },
    {
      "type": "simple_column",
      "alias": "date_created",
      "column": "e.date_created"
    },
    {
      "type": "derived_column",
      "alias": "anc_visit_number",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "MAX(CASE WHEN o.concept_id = 7086 THEN o.value_numeric END)"
      }
    },
    {
      "type": "derived_column",
      "alias": "kp_12019",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "COALESCE(MAX(o.concept_id = 12019 AND o.value_coded = 10407), 0)"
      }
    },
    {
      "type": "derived_column",
      "alias": "proph_val",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "MAX(CASE WHEN o.concept_id = 1895 THEN o.value_coded END)"
      }
    },
    {
      "type": "derived_column",
      "alias": "drug_obs_id",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "MAX(CASE WHEN o.concept_id = 1187 THEN o.obs_id END)"
      }
    }
  ],
  "filters": {
    "conditionJoinOperator": "and",
    "conditions": [
      {
        "filterType": "tableColumns",
        "conditionExpression": "e.location_id IN ?",
        "parameterName": "locations"
      },
      {
        "filterType": "tableColumns",
        "conditionExpression": "e.encounter_type IN (265, 264)"
      },
      {
        "filterType": "tableColumns",
        "conditionExpression": "e.encounter_datetime >= ?",
        "parameterName": "startDate"
      },
      {
        "filterType": "tableColumns",
        "conditionExpression": "e.encounter_datetime < DATE_ADD(?, INTERVAL 1 DAY)",
        "parameterName": "endDate"
      },
      {
        "filterType": "tableColumns",
        "conditionExpression": "e.voided = 0"
      }
    ]
  },
  "groupBy": {
    "columns": ["e.encounter_id"]
  }
}
