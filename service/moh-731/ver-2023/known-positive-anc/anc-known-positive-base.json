{
  "name": "moh731V2023AncKnownPositiveBase",
  "version": "1.0",
  "tag": "moh_731_ver_2023",
  "description": "MOH 731 (Ver. July 2023) 2.1 Known Positive at 1st ANC, step 2: the ANC visits of known-positive clients, with identifiers, HBV screening in the period, care status, ART start and infant prophylaxis. Carries the HV02-01 flag (the visits whose ANC visit number is 1) and the HV02-14 flag (those of them already on ART before the visit), which the aggregate sums and the patient list filters on.",
  "uses": [
    {
      "name": "moh731V2023AncKnownPositiveEncounters",
      "version": "1.0",
      "type": "dataset_def"
    },
    {
      "name": "moh731V2023HbvScreening",
      "version": "1.0",
      "type": "dataset_def"
    }
  ],
  "sources": [
    {
      "dataSet": "moh731V2023AncKnownPositiveEncounters",
      "alias": "b"
    },
    {
      "table": "amrs.person",
      "alias": "p",
      "join": {
        "type": "INNER",
        "joinCondition": "p.person_id = b.patient_id AND p.voided = 0"
      }
    },
    {
      "dataSet": "moh731V2023HbvScreening",
      "alias": "hbv",
      "join": {
        "type": "LEFT",
        "joinCondition": "hbv.person_id = b.patient_id"
      }
    },
    {
      "table": "etl.flat_hiv_summary_v15b",
      "alias": "fhs",
      "join": {
        "type": "LEFT",
        "joinCondition": "fhs.person_id = b.patient_id AND fhs.is_clinical_encounter = 1 AND fhs.next_clinical_datetime_hiv IS NULL"
      }
    },
    {
      "table": "amrs.obs",
      "alias": "drug",
      "join": {
        "type": "LEFT",
        "joinCondition": "drug.obs_id = b.drug_obs_id"
      }
    },
    {
      "table": "amrs.concept_name",
      "alias": "drug_cn",
      "join": {
        "type": "LEFT",
        "joinCondition": "drug_cn.concept_id = drug.value_coded AND drug_cn.locale_preferred = 1 AND drug_cn.voided = 0"
      }
    },
    {
      "table": "amrs.person_name",
      "alias": "pn",
      "join": {
        "type": "LEFT",
        "joinCondition": "pn.person_name_id = (SELECT pn2.person_name_id FROM amrs.person_name pn2 WHERE pn2.person_id = p.person_id AND pn2.voided = 0 ORDER BY pn2.preferred DESC, pn2.person_name_id DESC LIMIT 1)"
      }
    },
    {
      "table": "amrs.location",
      "alias": "l",
      "join": {
        "type": "LEFT",
        "joinCondition": "l.location_id = b.location_id"
      }
    },
    {
      "table": "amrs.encounter_type",
      "alias": "et",
      "join": {
        "type": "LEFT",
        "joinCondition": "et.encounter_type_id = b.encounter_type"
      }
    },
    {
      "table": "amrs.users",
      "alias": "u",
      "join": {
        "type": "LEFT",
        "joinCondition": "u.user_id = b.creator"
      }
    }
  ],
  "columns": [
    {
      "type": "simple_column",
      "alias": "encounter_id",
      "column": "b.encounter_id"
    },
    {
      "type": "derived_column",
      "alias": "visit",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "CASE b.encounter_type WHEN 265 THEN 'Initial' ELSE 'Return' END"
      }
    },
    {
      "type": "simple_column",
      "alias": "encounter_type",
      "column": "et.name"
    },
    {
      "type": "simple_column",
      "alias": "anc_visit_number",
      "column": "b.anc_visit_number"
    },
    {
      "type": "derived_column",
      "alias": "anc_date",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "DATE(b.encounter_datetime)"
      }
    },
    {
      "type": "simple_column",
      "alias": "location_id",
      "column": "b.location_id"
    },
    {
      "type": "simple_column",
      "alias": "location",
      "column": "l.name"
    },
    {
      "type": "simple_column",
      "alias": "patient_id",
      "column": "p.person_id"
    },
    {
      "type": "simple_column",
      "alias": "patient_uuid",
      "column": "p.uuid"
    },
    {
      "type": "derived_column",
      "alias": "amrs_number",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "(SELECT pi.identifier FROM amrs.patient_identifier pi WHERE pi.patient_id = p.person_id AND pi.identifier_type = 8 AND pi.voided = 0 ORDER BY pi.preferred DESC, pi.patient_identifier_id DESC LIMIT 1)"
      }
    },
    {
      "type": "derived_column",
      "alias": "ccc_number",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "(SELECT pi.identifier FROM amrs.patient_identifier pi WHERE pi.patient_id = p.person_id AND pi.identifier_type = 28 AND pi.voided = 0 ORDER BY pi.preferred DESC, pi.patient_identifier_id DESC LIMIT 1)"
      }
    },
    {
      "type": "derived_column",
      "alias": "nupi",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "(SELECT pi.identifier FROM amrs.patient_identifier pi WHERE pi.patient_id = p.person_id AND pi.identifier_type = 45 AND pi.voided = 0 ORDER BY pi.preferred DESC, pi.patient_identifier_id DESC LIMIT 1)"
      }
    },
    {
      "type": "derived_column",
      "alias": "full_name",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "CONCAT_WS(' ', pn.given_name, pn.middle_name, pn.family_name)"
      }
    },
    {
      "type": "simple_column",
      "alias": "gender",
      "column": "p.gender"
    },
    {
      "type": "simple_column",
      "alias": "birthdate",
      "column": "p.birthdate"
    },
    {
      "type": "derived_column",
      "alias": "age_at_anc",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "TIMESTAMPDIFF(YEAR, p.birthdate, b.encounter_datetime)"
      }
    },
    {
      "type": "derived_column",
      "alias": "hiv_status",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "'Known Positive'"
      }
    },
    {
      "type": "derived_column",
      "alias": "known_positive_source",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "CASE WHEN b.kp_12019 = 1 THEN 'HIV test performed (12019)' END"
      }
    },
    {
      "type": "derived_column",
      "alias": "screened_hbv",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "CASE WHEN hbv.person_id IS NOT NULL THEN 'Yes' ELSE 'No' END"
      }
    },
    {
      "type": "derived_column",
      "alias": "hbv_result",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "CASE hbv.hbv_positive WHEN 1 THEN 'Positive' WHEN 0 THEN 'Negative' END"
      }
    },
    {
      "type": "derived_column",
      "alias": "hbv_test_date",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "DATE(hbv.hbv_test_datetime)"
      }
    },
    {
      "type": "simple_column",
      "alias": "hbv_encounter_types",
      "column": "hbv.hbv_encounter_types"
    },
    {
      "type": "derived_column",
      "alias": "initiated_in_care",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "CASE WHEN fhs.person_id IS NOT NULL THEN 'Yes' ELSE 'No' END"
      }
    },
    {
      "type": "derived_column",
      "alias": "arv_first_regimen_start_date",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "DATE(fhs.arv_first_regimen_start_date)"
      }
    },
    {
      "type": "derived_column",
      "alias": "infant_prophylaxis_dispensed",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "CASE WHEN b.anc_visit_number = 1 THEN CASE WHEN b.proph_val = 1065 THEN 'Yes' ELSE 'No' END END"
      }
    },
    {
      "type": "derived_column",
      "alias": "infant_prophylaxis_regimen",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "CASE WHEN b.anc_visit_number = 1 AND b.proph_val = 1065 THEN drug_cn.name END"
      }
    },
    {
      "type": "simple_column",
      "alias": "entered_by",
      "column": "u.username"
    },
    {
      "type": "simple_column",
      "alias": "date_created",
      "column": "b.date_created"
    },
    {
      "type": "derived_column",
      "alias": "known_positive_1st_anc",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "IF(b.anc_visit_number = 1, 1, NULL)"
      }
    },
    {
      "type": "derived_column",
      "alias": "maternal_haart_1st_anc",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "IF(b.anc_visit_number = 1 AND DATE(fhs.arv_first_regimen_start_date) < DATE(b.encounter_datetime), 1, NULL)"
      }
    },
    {
      "type": "derived_column",
      "alias": "known_positive_anc_10_19",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "IF((b.anc_visit_number = 1) AND TIMESTAMPDIFF(YEAR, p.birthdate, b.encounter_datetime) BETWEEN 10 AND 19, 1, NULL)"
      }
    },
    {
      "type": "derived_column",
      "alias": "known_positive_anc_20_24",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "IF((b.anc_visit_number = 1) AND TIMESTAMPDIFF(YEAR, p.birthdate, b.encounter_datetime) BETWEEN 20 AND 24, 1, NULL)"
      }
    },
    {
      "type": "derived_column",
      "alias": "on_art_anc_10_19",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "IF((b.anc_visit_number = 1 AND DATE(fhs.arv_first_regimen_start_date) < DATE(b.encounter_datetime)) AND TIMESTAMPDIFF(YEAR, p.birthdate, b.encounter_datetime) BETWEEN 10 AND 19, 1, NULL)"
      }
    },
    {
      "type": "derived_column",
      "alias": "on_art_anc_20_24",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "IF((b.anc_visit_number = 1 AND DATE(fhs.arv_first_regimen_start_date) < DATE(b.encounter_datetime)) AND TIMESTAMPDIFF(YEAR, p.birthdate, b.encounter_datetime) BETWEEN 20 AND 24, 1, NULL)"
      }
    }
  ],
  "filters": {
    "conditionJoinOperator": "and",
    "conditions": [
      {
        "filterType": "tableColumns",
        "conditionExpression": "b.kp_12019 = 1"
      }
    ]
  },
  "orderBy": {
    "columns": [
      {
        "column": "b.encounter_datetime",
        "order": "asc"
      },
      {
        "column": "b.encounter_id",
        "order": "asc"
      }
    ]
  }
}
