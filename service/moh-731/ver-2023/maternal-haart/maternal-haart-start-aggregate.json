{
  "name": "moh731V2023MaternalHaartStartAggregate",
  "version": "1.0",
  "tag": "moh_731_ver_2023",
  "description": "MOH 731 (Ver. July 2023) 2.3 Maternal HAART. HV02-15 Start HAART_ANC and HV02-16 Start HAART_L&D: positive tests at ANC, or at Maternity (L&D), in the period where the client's first ART regimen started no later than the last day of the period. HV02-17 / HV02-18 Start HAART_PNC <=6 / >6 weeks: of the PNC positives in HV02-12 / HV02-13 (split at 42 days after delivery), those whose first ART regimen started within the period. 0 when there are none.",
  "uses": [
    {
      "name": "moh731V2023HivTestsBase",
      "version": "1.0",
      "type": "dataset_def"
    }
  ],
  "sources": [
    {
      "dataSet": "moh731V2023HivTestsBase",
      "alias": "hts"
    }
  ],
  "columns": [
    {
      "type": "derived_column",
      "alias": "start_maternal_haart_1st_anc",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "COALESCE(SUM(hts.start_maternal_haart_1st_anc), 0)"
      }
    },
    {
      "type": "derived_column",
      "alias": "start_maternal_haart_LD",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "COALESCE(SUM(hts.start_maternal_haart_LD), 0)"
      }
    },
    {
      "type": "derived_column",
      "alias": "maternal_haart_less_6_weeks",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "COALESCE(SUM(hts.maternal_haart_less_6_weeks), 0)"
      }
    },
    {
      "type": "derived_column",
      "alias": "maternal_haart_more_6_weeks",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "COALESCE(SUM(hts.maternal_haart_more_6_weeks), 0)"
      }
    }
  ],
