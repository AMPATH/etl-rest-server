{
  "name": "moh731V2023DsdEstablishedBase",
  "version": "1.0",
  "tag": "moh_731_ver_2023",
  "description": "MOH 731 (Ver. July 2023) 3.5 Differentiated Service Delivery, HV03-033 Established and HV03-034 Not Established: a copy of the earlier O3 dataset establishedBase3X -- the same sources, filters and grouping, so the same clients -- with the figure's flag named as its indicator and the client's name, identifiers and location for the linelist.",
  "uses": [],
  "sources": [
    {
      "table": "etl.hiv_monthly_report_dataset_frozen",
      "alias": "fr"
    },
    {
      "table": "etl.flat_hiv_summary_v15b",
      "alias": "fhs",
      "join": {
        "type": "LEFT",
        "joinCondition": "fr.encounter_id = fhs.encounter_id AND fhs.is_clinical_encounter = 1"
      }
    },
    {
      "table": "etl.flat_obs",
      "alias": "fo",
      "join": {
        "type": "LEFT",
        "joinCondition": "fo.encounter_id = fhs.encounter_id"
      }
    },
    {
      "table": "etl.flat_patient_identifiers_v1",
      "alias": "flat_identifiers",
      "join": {
        "type": "LEFT",
        "joinCondition": "fo.person_id = flat_identifiers.patient_id"
      }
    },
    {
      "table": "amrs.person",
      "alias": "pp",
      "join": {
        "type": "LEFT",
        "joinCondition": "pp.person_id = fr.person_id"
      }
    },
    {
      "table": "amrs.person_name",
      "alias": "pn",
      "join": {
        "type": "LEFT",
        "joinCondition": "pn.person_name_id = (SELECT pn2.person_name_id FROM amrs.person_name pn2 WHERE pn2.person_id = fr.person_id AND pn2.voided = 0 ORDER BY pn2.preferred DESC, pn2.person_name_id DESC LIMIT 1)"
      }
    },
    {
      "table": "amrs.location",
      "alias": "l",
      "join": {
        "type": "LEFT",
        "joinCondition": "l.location_id = fr.location_id"
      }
    }
  ],
  "columns": [
    {
      "type": "simple_column",
      "alias": "person_id",
      "column": "fo.person_id"
    },
    {
      "type": "simple_column",
      "alias": "ccc_number",
      "column": "flat_identifiers.ccc"
    },
    {
      "type": "simple_column",
      "alias": "upi_number",
      "column": "flat_identifiers.nupi"
    },
    {
      "type": "simple_column",
      "alias": "encounter_id",
      "column": "fo.encounter_id"
    },
    {
      "type": "derived_column",
      "alias": "established",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "CASE WHEN (fo.obs REGEXP '!!12108=') AND etl.getValues(fo.obs,12108) = 12106 THEN 1 ELSE NULL END"
      }
    },
    {
      "type": "derived_column",
      "alias": "not_established",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "CASE WHEN (fo.obs REGEXP '!!12108=' OR fo.obs REGEXP '!!12127=') THEN (CASE WHEN etl.getValues(fo.obs,12108) = 12107 OR etl.getValues(fo.obs,12127) = 9070 OR etl.getValues(fo.obs,12127) = 12266 THEN 1 ELSE NULL END) ELSE 1 END"
      }
    },
    {
      "type": "simple_column",
      "alias": "patient_id",
      "column": "fr.person_id"
    },
    {
      "type": "derived_column",
      "alias": "amrs_number",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "(SELECT pi.identifier FROM amrs.patient_identifier pi WHERE pi.patient_id = fr.person_id AND pi.identifier_type = 8 AND pi.voided = 0 ORDER BY pi.preferred DESC, pi.patient_identifier_id DESC LIMIT 1)"
      }
    },
    {
      "type": "derived_column",
      "alias": "nupi",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "(SELECT pi.identifier FROM amrs.patient_identifier pi WHERE pi.patient_id = fr.person_id AND pi.identifier_type = 45 AND pi.voided = 0 ORDER BY pi.preferred DESC, pi.patient_identifier_id DESC LIMIT 1)"
      }
    },
    {
      "type": "derived_column",
      "alias": "full_name",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "CONCAT_WS(' ', pn.given_name, pn.middle_name, pn.family_name)"
      }
    },
    {
      "type": "simple_column",
      "alias": "gender",
      "column": "pp.gender"
    },
    {
      "type": "derived_column",
      "alias": "age",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "fr.age"
      }
    },
    {
      "type": "simple_column",
      "alias": "location",
      "column": "l.name"
    },
    {
      "type": "derived_column",
      "alias": "arv_first_regimen_start_date",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "DATE(fr.arv_first_regimen_start_date)"
      }
    },
    {
      "type": "derived_column",
      "alias": "last_visit_date",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "DATE(fr.encounter_date)"
      }
    },
    {
      "type": "derived_column",
      "alias": "dsd_status",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "CASE WHEN (fo.obs REGEXP '!!12108=') AND etl.getValues(fo.obs,12108) = 12106 THEN 'Established' WHEN (fo.obs REGEXP '!!12108=' OR fo.obs REGEXP '!!12127=') THEN 'Not established' END"
      }
    }
  ],
  "filters": {
    "conditionJoinOperator": "and",
    "conditions": [
      {
        "filterType": "tableColumns",
        "conditionExpression": "fr.status = 'active'"
      },
      {
        "filterType": "tableColumns",
        "conditionExpression": "fr.on_art_this_month = 1"
      },
      {
        "filterType": "tableColumns",
        "conditionExpression": "fr.endDate = ?",
        "parameterName": "endDate"
      },
      {
        "filterType": "tableColumns",
        "conditionExpression": "fr.location_id in ?",
        "parameterName": "locations"
      }
    ]
  },
  "groupBy": {
    "groupParam": "groupByParam",
    "columns": ["fr.person_id"],
    "excludeParam": "excludeParam"
  }
}
