{
  "name": "moh731V2023StartingTptAggregate",
  "version": "1.0",
  "tag": "moh_731_ver_2023",
  "description": "MOH 731 (Ver. July 2023) 3.4 Starting TPT, HV03-031 Start TPT_<15 and HV03-032 Start TPT_15+: as the earlier O3 aggregate tptAggregate3X, summing the base flags, but 0 rather than empty when there are none.",
  "uses": [
    {
      "name": "moh731V2023StartingTptBase",
      "version": "1.0",
      "type": "dataset_def"
    }
  ],
  "sources": [
    {
      "dataSet": "moh731V2023StartingTptBase",
      "alias": "x"
    }
  ],
  "columns": [
    {
      "type": "derived_column",
      "alias": "start_tpt_less_15",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "COALESCE(SUM(x.start_tpt_less_15), 0)"
      }
    },
    {
      "type": "derived_column",
      "alias": "start_tpt_greater_15",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "COALESCE(SUM(x.start_tpt_greater_15), 0)"
      }
    }
  ],
  "transFormDirectives": {
    "joinColumn": "location_id",
    "joinColumnParam": "",
    "skipColumns": [""],
    "disaggregationColumns": []
  },
  "dynamicJsonQueryGenerationDirectives": {
    "patientListGenerator": {
      "useTemplate": "moh731V2023TbDsdPatientListTemplate",
      "useTemplateVersion": "1.0",
      "generatingDirectives": {
        "joinDirectives": {
          "joinType": "INNER",
          "joinCondition": "<<base_column>> = <<template_column>>",
          "baseColumn": "person_id",
          "templateColumn": "person_id"
        }
      }
    }
  }
}
