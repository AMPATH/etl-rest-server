{
  "name": "moh731V2023PepBase",
  "version": "1.0",
  "tag": "moh_731_ver_2023",
  "description": "MOH 731 (Ver. July 2023) 5. Post Exposure Prophylaxis, step 3: the exposures -- one row per PEP initial encounter with a method of exposure, at most one per client per day (moh731V2023PepDays) -- with the client's identifiers. HV05-01 Exposed_Occupational: exposure 7094 (occupational). HV05-02 Exposed Other: any other exposure, sexual assault (165) included. HV05-03 / HV05-04 PEP_Occupational / PEP_Other: the same, where PEP was given at that encounter (1705 = 1149). Carries a flag per figure, which the aggregate sums and the patient list filters on.",
  "uses": [
    {
      "name": "moh731V2023PepDays",
      "version": "1.0",
      "type": "dataset_def"
    }
  ],
  "sources": [
    {
      "dataSet": "moh731V2023PepDays",
      "alias": "b"
    },
    {
      "table": "amrs.person",
      "alias": "p",
      "join": {
        "type": "INNER",
        "joinCondition": "p.person_id = b.patient_id AND p.voided = 0"
      }
    },
    {
      "table": "amrs.person_name",
      "alias": "pn",
      "join": {
        "type": "LEFT",
        "joinCondition": "pn.person_name_id = (SELECT pn2.person_name_id FROM amrs.person_name pn2 WHERE pn2.person_id = p.person_id AND pn2.voided = 0 ORDER BY pn2.preferred DESC, pn2.person_name_id DESC LIMIT 1)"
      }
    },
    {
      "table": "amrs.concept_name",
      "alias": "ex_cn",
      "join": {
        "type": "LEFT",
        "joinCondition": "ex_cn.concept_name_id = (SELECT cn2.concept_name_id FROM amrs.concept_name cn2 WHERE cn2.concept_id = b.exposure AND cn2.locale_preferred = 1 AND cn2.voided = 0 ORDER BY cn2.concept_name_id LIMIT 1)"
      }
    },
    {
      "table": "amrs.location",
      "alias": "l",
      "join": {
        "type": "LEFT",
        "joinCondition": "l.location_id = b.location_id"
      }
    },
    {
      "table": "amrs.users",
      "alias": "u",
      "join": {
        "type": "LEFT",
        "joinCondition": "u.user_id = b.creator"
      }
    }
  ],
  "columns": [
    {
      "type": "simple_column",
      "alias": "encounter_id",
      "column": "b.encounter_id"
    },
    {
      "type": "derived_column",
      "alias": "exposure_date",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "DATE(b.encounter_datetime)"
      }
    },
    {
      "type": "simple_column",
      "alias": "location_id",
      "column": "b.location_id"
    },
    {
      "type": "simple_column",
      "alias": "location",
      "column": "l.name"
    },
    {
      "type": "simple_column",
      "alias": "exposure_type",
      "column": "ex_cn.name"
    },
    {
      "type": "derived_column",
      "alias": "pep_given_status",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "IF(b.pep_given = 1, 'Yes', 'No')"
      }
    },
    {
      "type": "simple_column",
      "alias": "patient_id",
      "column": "p.person_id"
    },
    {
      "type": "simple_column",
      "alias": "person_id",
      "column": "p.person_id"
    },
    {
      "type": "simple_column",
      "alias": "patient_uuid",
      "column": "p.uuid"
    },
    {
      "type": "derived_column",
      "alias": "amrs_number",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "(SELECT pi.identifier FROM amrs.patient_identifier pi WHERE pi.patient_id = p.person_id AND pi.identifier_type = 8 AND pi.voided = 0 ORDER BY pi.preferred DESC, pi.patient_identifier_id DESC LIMIT 1)"
      }
    },
    {
      "type": "derived_column",
      "alias": "ccc_number",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "(SELECT pi.identifier FROM amrs.patient_identifier pi WHERE pi.patient_id = p.person_id AND pi.identifier_type = 28 AND pi.voided = 0 ORDER BY pi.preferred DESC, pi.patient_identifier_id DESC LIMIT 1)"
      }
    },
    {
      "type": "derived_column",
      "alias": "nupi",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "(SELECT pi.identifier FROM amrs.patient_identifier pi WHERE pi.patient_id = p.person_id AND pi.identifier_type = 45 AND pi.voided = 0 ORDER BY pi.preferred DESC, pi.patient_identifier_id DESC LIMIT 1)"
      }
    },
    {
      "type": "derived_column",
      "alias": "full_name",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "CONCAT_WS(' ', pn.given_name, pn.middle_name, pn.family_name)"
      }
    },
    {
      "type": "simple_column",
      "alias": "gender",
      "column": "p.gender"
    },
    {
      "type": "derived_column",
      "alias": "age",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "TIMESTAMPDIFF(YEAR, p.birthdate, b.encounter_datetime)"
      }
    },
    {
      "type": "simple_column",
      "alias": "entered_by",
      "column": "u.username"
    },
    {
      "type": "simple_column",
      "alias": "date_created",
      "column": "b.date_created"
    },
    {
      "type": "derived_column",
      "alias": "exposed_occupational",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "IF(b.exposure = 7094, 1, NULL)"
      }
    },
    {
      "type": "derived_column",
      "alias": "exposed_non_occupational",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "IF(b.exposure <> 7094, 1, NULL)"
      }
    },
    {
      "type": "derived_column",
      "alias": "pep_occupational",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "IF(b.exposure = 7094 AND b.pep_given = 1, 1, NULL)"
      }
    },
    {
      "type": "derived_column",
      "alias": "pep_non_occupational",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "IF(b.exposure <> 7094 AND b.pep_given = 1, 1, NULL)"
      }
    }
  ],
  "filters": {
    "conditionJoinOperator": "and",
    "conditions": [
      {
        "filterType": "tableColumns",
        "conditionExpression": "b.day_rank = 1"
      }
    ]
  },
  "orderBy": {
    "columns": [
      {
        "column": "b.encounter_datetime",
        "order": "asc"
      },
      {
        "column": "b.encounter_id",
        "order": "asc"
      }
    ]
  }
}
