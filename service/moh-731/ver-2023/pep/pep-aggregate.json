{
  "name": "moh731V2023PepAggregate",
  "version": "1.0",
  "tag": "moh_731_ver_2023",
  "description": "MOH 731 (Ver. July 2023) 5. Post Exposure Prophylaxis, HV05-01 to HV05-04: exposures by occupational / other, and of those, PEP given. 0 when there are none.",
  "uses": [
    {
      "name": "moh731V2023PepBase",
      "version": "1.0",
      "type": "dataset_def"
    }
  ],
  "sources": [
    {
      "dataSet": "moh731V2023PepBase",
      "alias": "pep"
    }
  ],
  "columns": [
    {
      "type": "derived_column",
      "alias": "exposed_occupational",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "COALESCE(SUM(pep.exposed_occupational), 0)"
      }
    },
    {
      "type": "derived_column",
      "alias": "exposed_non_occupational",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "COALESCE(SUM(pep.exposed_non_occupational), 0)"
      }
    },
    {
      "type": "derived_column",
      "alias": "pep_occupational",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "COALESCE(SUM(pep.pep_occupational), 0)"
      }
    },
    {
      "type": "derived_column",
      "alias": "pep_non_occupational",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "COALESCE(SUM(pep.pep_non_occupational), 0)"
      }
    }
  ],
  "transFormDirectives": {
    "joinColumn": "location_id",
    "joinColumnParam": "",
    "skipColumns": [""],
    "disaggregationColumns": []
  },
  "dynamicJsonQueryGenerationDirectives": {
    "patientListGenerator": {
      "useTemplate": "moh731V2023PepPatientListTemplate",
      "useTemplateVersion": "1.0",
      "generatingDirectives": {
        "joinDirectives": {
          "joinType": "INNER",
          "joinCondition": "<<base_column>> = <<template_column>>",
          "baseColumn": "patient_id",
          "templateColumn": "person_id"
        }
      }
    }
  }
}
