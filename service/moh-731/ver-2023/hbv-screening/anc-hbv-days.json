{
  "name": "moh731V2023AncHbvDays",
  "version": "1.0",
  "tag": "moh_731_ver_2023",
  "description": "MOH 731 (Ver. July 2023) 2.4 HBV Screening at ANC, step 2: the ANC visits that are an ANC test or a known-positive visit, ranked within each client's day by day_rank, so a client seen more than once on a day counts once (the latest visit is kept). The base keeps day_rank = 1.",
  "uses": [
    {
      "name": "moh731V2023AncHbvEncounters",
      "version": "1.0",
      "type": "dataset_def"
    }
  ],
  "sources": [
    {
      "dataSet": "moh731V2023AncHbvEncounters",
      "alias": "b"
    }
  ],
  "columns": [
    {
      "type": "simple_column",
      "alias": "encounter_id",
      "column": "b.encounter_id"
    },
    {
      "type": "simple_column",
      "alias": "patient_id",
      "column": "b.patient_id"
    },
    {
      "type": "simple_column",
      "alias": "encounter_datetime",
      "column": "b.encounter_datetime"
    },
    {
      "type": "simple_column",
      "alias": "location_id",
      "column": "b.location_id"
    },
    {
      "type": "simple_column",
      "alias": "encounter_type",
      "column": "b.encounter_type"
    },
    {
      "type": "simple_column",
      "alias": "creator",
      "column": "b.creator"
    },
    {
      "type": "simple_column",
      "alias": "date_created",
      "column": "b.date_created"
    },
    {
      "type": "simple_column",
      "alias": "res_id",
      "column": "b.res_id"
    },
    {
      "type": "simple_column",
      "alias": "tt_id",
      "column": "b.tt_id"
    },
    {
      "type": "simple_column",
      "alias": "anc_visit_number",
      "column": "b.anc_visit_number"
    },
    {
      "type": "simple_column",
      "alias": "has_revisit",
      "column": "b.has_revisit"
    },
    {
      "type": "simple_column",
      "alias": "kp_12019",
      "column": "b.kp_12019"
    },
    {
      "type": "derived_column",
      "alias": "day_rank",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "ROW_NUMBER() OVER (PARTITION BY b.patient_id, DATE(b.encounter_datetime) ORDER BY b.encounter_datetime DESC, b.encounter_id DESC)"
      }
    }
  ],
  "filters": {
    "conditionJoinOperator": "and",
    "conditions": [
      {
        "filterType": "tableColumns",
        "conditionExpression": "((b.res_id IS NOT NULL AND b.tt_id IS NOT NULL AND b.has_revisit = 0) OR (b.kp_12019 = 1))"
      }
    ]
  }
