{
  "name": "moh731V2023AncHbvBase",
  "version": "1.0",
  "tag": "moh_731_ver_2023",
  "description": "MOH 731 (Ver. July 2023) 2.4 HBV Screening at ANC, step 3: the ANC visits that are an ANC test (as in 1.1 HIV Tests) or a known-positive visit (as in Known Positive at 1st ANC) -- one row per visit and at most one per client per day (moh731V2023AncHbvDays), a visit that is both listed once -- with the client's HBV screening in the period. Carries the HV02-19 (screened) and HV02-20 (HBV positive) flags, which the aggregate sums and the patient list filters on.",
  "uses": [
    {
      "name": "moh731V2023AncHbvDays",
      "version": "1.0",
      "type": "dataset_def"
    },
    {
      "name": "moh731V2023HbvScreening",
      "version": "1.0",
      "type": "dataset_def"
    }
  ],
  "sources": [
    {
      "dataSet": "moh731V2023AncHbvDays",
      "alias": "b"
    },
    {
      "table": "amrs.person",
      "alias": "p",
      "join": {
        "type": "INNER",
        "joinCondition": "p.person_id = b.patient_id AND p.voided = 0"
      }
    },
    {
      "table": "amrs.obs",
      "alias": "fr",
      "join": {
        "type": "LEFT",
        "joinCondition": "fr.obs_id = b.res_id"
      }
    },
    {
      "dataSet": "moh731V2023HbvScreening",
      "alias": "hbv",
      "join": {
        "type": "LEFT",
        "joinCondition": "hbv.person_id = b.patient_id"
      }
    },
    {
      "table": "amrs.person_name",
      "alias": "pn",
      "join": {
        "type": "LEFT",
        "joinCondition": "pn.person_name_id = (SELECT pn2.person_name_id FROM amrs.person_name pn2 WHERE pn2.person_id = p.person_id AND pn2.voided = 0 ORDER BY pn2.preferred DESC, pn2.person_name_id DESC LIMIT 1)"
      }
    },
    {
      "table": "amrs.location",
      "alias": "l",
      "join": {
        "type": "LEFT",
        "joinCondition": "l.location_id = b.location_id"
      }
    },
    {
      "table": "amrs.encounter_type",
      "alias": "et",
      "join": {
        "type": "LEFT",
        "joinCondition": "et.encounter_type_id = b.encounter_type"
      }
    },
    {
      "table": "amrs.users",
      "alias": "u",
      "join": {
        "type": "LEFT",
        "joinCondition": "u.user_id = b.creator"
      }
    }
  ],
  "columns": [
    {
      "type": "simple_column",
      "alias": "encounter_id",
      "column": "b.encounter_id"
    },
    {
      "type": "derived_column",
      "alias": "visit",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "CASE b.encounter_type WHEN 265 THEN 'Initial' ELSE 'Return' END"
      }
    },
    {
      "type": "simple_column",
      "alias": "encounter_type",
      "column": "et.name"
    },
    {
      "type": "simple_column",
      "alias": "anc_visit_number",
      "column": "b.anc_visit_number"
    },
    {
      "type": "derived_column",
      "alias": "anc_date",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "DATE(b.encounter_datetime)"
      }
    },
    {
      "type": "simple_column",
      "alias": "location_id",
      "column": "b.location_id"
    },
    {
      "type": "simple_column",
      "alias": "location",
      "column": "l.name"
    },
    {
      "type": "derived_column",
      "alias": "anc_group",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "CASE WHEN (b.res_id IS NOT NULL AND b.tt_id IS NOT NULL AND b.has_revisit = 0) AND (b.kp_12019 = 1) THEN 'ANC test and ANC known positive' WHEN (b.res_id IS NOT NULL AND b.tt_id IS NOT NULL AND b.has_revisit = 0) THEN 'ANC test' ELSE 'ANC known positive' END"
      }
    },
    {
      "type": "derived_column",
      "alias": "hiv_result",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "CASE WHEN b.kp_12019 = 1 THEN 'Known Positive' ELSE CASE fr.value_coded WHEN 703 THEN 'Positive' WHEN 664 THEN 'Negative' WHEN 1138 THEN 'Inconclusive' ELSE fr.value_coded END END"
      }
    },
    {
      "type": "simple_column",
      "alias": "patient_id",
      "column": "p.person_id"
    },
    {
      "type": "simple_column",
      "alias": "patient_uuid",
      "column": "p.uuid"
    },
    {
      "type": "derived_column",
      "alias": "amrs_number",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "(SELECT pi.identifier FROM amrs.patient_identifier pi WHERE pi.patient_id = p.person_id AND pi.identifier_type = 8 AND pi.voided = 0 ORDER BY pi.preferred DESC, pi.patient_identifier_id DESC LIMIT 1)"
      }
    },
    {
      "type": "derived_column",
      "alias": "ccc_number",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "(SELECT pi.identifier FROM amrs.patient_identifier pi WHERE pi.patient_id = p.person_id AND pi.identifier_type = 28 AND pi.voided = 0 ORDER BY pi.preferred DESC, pi.patient_identifier_id DESC LIMIT 1)"
      }
    },
    {
      "type": "derived_column",
      "alias": "nupi",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "(SELECT pi.identifier FROM amrs.patient_identifier pi WHERE pi.patient_id = p.person_id AND pi.identifier_type = 45 AND pi.voided = 0 ORDER BY pi.preferred DESC, pi.patient_identifier_id DESC LIMIT 1)"
      }
    },
    {
      "type": "derived_column",
      "alias": "full_name",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "CONCAT_WS(' ', pn.given_name, pn.middle_name, pn.family_name)"
      }
    },
    {
      "type": "simple_column",
      "alias": "gender",
      "column": "p.gender"
    },
    {
      "type": "simple_column",
      "alias": "birthdate",
      "column": "p.birthdate"
    },
    {
      "type": "derived_column",
      "alias": "age_at_anc",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "TIMESTAMPDIFF(YEAR, p.birthdate, b.encounter_datetime)"
      }
    },
    {
      "type": "derived_column",
      "alias": "screened_hbv",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "CASE WHEN hbv.person_id IS NOT NULL THEN 'Yes' ELSE 'No' END"
      }
    },
    {
      "type": "derived_column",
      "alias": "hbv_result",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "CASE hbv.hbv_positive WHEN 1 THEN 'Positive' WHEN 0 THEN 'Negative' END"
      }
    },
    {
      "type": "derived_column",
      "alias": "hbv_test_date",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "DATE(hbv.hbv_test_datetime)"
      }
    },
    {
      "type": "simple_column",
      "alias": "hbv_encounter_types",
      "column": "hbv.hbv_encounter_types"
    },
    {
      "type": "simple_column",
      "alias": "entered_by",
      "column": "u.username"
    },
    {
      "type": "simple_column",
      "alias": "date_created",
      "column": "b.date_created"
    },
    {
      "type": "derived_column",
      "alias": "hbv_screened_anc",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "IF(hbv.person_id IS NOT NULL, 1, NULL)"
      }
    },
    {
      "type": "derived_column",
      "alias": "hbv_screened_positive_anc",
      "expressionType": "simple_expression",
      "expressionOptions": {
        "expression": "IF(hbv.hbv_positive = 1, 1, NULL)"
      }
    }
  ],
  "filters": {
    "conditionJoinOperator": "and",
    "conditions": [
      {
        "filterType": "tableColumns",
        "conditionExpression": "((b.res_id IS NOT NULL AND b.tt_id IS NOT NULL AND b.has_revisit = 0) OR (b.kp_12019 = 1))"
      },
      {
        "filterType": "tableColumns",
        "conditionExpression": "b.day_rank = 1"
      }
    ]
  },
  "orderBy": {
    "columns": [
      {
        "column": "b.encounter_datetime",
        "order": "asc"
      },
      {
        "column": "b.encounter_id",
        "order": "asc"
      }
    ]
  }
}
